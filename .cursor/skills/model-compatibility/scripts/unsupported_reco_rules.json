{
  "version": "3.0",
  "description": "Where to implement an ONNX operator hip-ep has no converter for. Only that case reaches these rules: an operator whose conversion exists but refused the model is reported as 'Extend the existing conversion', and a converted one names the runtime function the conversion actually produced. Every wrapper below exists in lib/Runtime/hipdnn_ep_runtime.h; when that stops being true the rule is stale, because the report would name a symbol nobody can extend.",
  "default_fallback": {
    "recommended_path": "Custom Hip Kernel",
    "wrapper_extension_target": "new custom wrapper",
    "rationale": "No existing runtime path covers this operator's semantics."
  },
  "compile_time_rule": {
    "when_reason_contains_any": [
      "compile time",
      "compile-time",
      "constant folding",
      "shape inference",
      "shape manipulation",
      "type-canonicalization"
    ],
    "recommended_path": "Compile Time Optimization",
    "wrapper_extension_target": "none",
    "rationale": "Operation is handled by compile-time transformation or shape/type propagation."
  },
  "op_overrides": [
    {
      "op_name": "Reciprocal",
      "recommended_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_power",
      "rationale": "wrap_power already implements reciprocal and sqrt."
    },
    {
      "op_name": "Sqrt",
      "recommended_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_power",
      "rationale": "wrap_power already implements reciprocal and sqrt."
    }
  ],
  "family_routing": [
    {
      "family": "matmul",
      "op_name_keywords_any": [
        "matmul",
        "gemm"
      ],
      "preferred_path": "hipBLASLt",
      "wrapper_extension_target": "wrap_hipblasLtMatmul",
      "fallback_path": "Custom Hip Kernel",
      "notes": "Dense matmul is the one family that reaches a vendor library; wrap_gemm and wrap_matmul_nbits cover the ONNX Gemm and quantized variants."
    },
    {
      "family": "convolution",
      "op_name_keywords_any": [
        "conv"
      ],
      "preferred_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_conv",
      "fallback_path": "Custom Hip Kernel",
      "notes": "wrap_conv_transpose and wrap_qconv exist for the transpose and quantized cases."
    },
    {
      "family": "activation",
      "op_name_keywords_any": [
        "relu",
        "sigmoid",
        "tanh",
        "softplus",
        "gelu",
        "swish",
        "silu",
        "elu",
        "clip"
      ],
      "preferred_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_sigmoid / wrap_gelu / wrap_tanh family",
      "fallback_path": "Custom Hip Kernel",
      "notes": "Activations are in-tree kernels, one wrapper per activation; adding one follows the existing pattern."
    },
    {
      "family": "elementwise_binary",
      "op_name_keywords_any": [
        "add",
        "mul",
        "min",
        "max",
        "div",
        "sub"
      ],
      "preferred_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_elementwise",
      "fallback_path": "Custom Hip Kernel",
      "notes": "wrap_elementwise carries add / mul / min / max with broadcasting; wrap_div and wrap_elementwise_sub are separate entry points."
    },
    {
      "family": "reduction",
      "op_name_keywords_any": [
        "reduce",
        "cumsum"
      ],
      "preferred_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_reduce_sum",
      "fallback_path": "Custom Hip Kernel",
      "notes": "wrap_reduce_mean / _max / _min / _prod / _l2 and wrap_cumsum share the same shape."
    },
    {
      "family": "indexing_data_movement",
      "op_name_keywords_any": [
        "gather",
        "scatter",
        "slice",
        "split",
        "tile",
        "pad",
        "concat",
        "expand",
        "transpose"
      ],
      "preferred_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_gather / wrap_scatter_elements / wrap_slice family",
      "fallback_path": "Custom Hip Kernel",
      "notes": "Many of these lower to tensor ops at compile time instead; check the conversion before adding a kernel."
    },
    {
      "family": "control_flow",
      "op_name_keywords_any": [
        "loop",
        "if",
        "scan"
      ],
      "preferred_path": "Graph lowering",
      "wrapper_extension_target": "none",
      "fallback_path": "Custom Hip Kernel",
      "notes": "Control flow is outlined by onnx-loop-outline / onnx-if-outline rather than by a runtime call."
    },
    {
      "family": "attention_composite",
      "op_name_keywords_any": [
        "attention"
      ],
      "preferred_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_group_query_attention / wrap_multi_head_attention",
      "fallback_path": "Custom Hip Kernel",
      "notes": "Both drive hipBLASLt for their matmuls and custom kernels around them."
    },
    {
      "family": "normalization_composite",
      "op_name_keywords_any": [
        "layernormalization",
        "groupnormalization",
        "rmsnorm",
        "batchnormalization"
      ],
      "preferred_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_rms_norm / wrap_layer_normalization",
      "fallback_path": "Custom Hip Kernel",
      "notes": "wrap_skip_simplified_layer_norm and wrap_instance_normalization cover the fused and per-instance variants."
    },
    {
      "family": "rotary_embedding",
      "op_name_keywords_any": [
        "rotary"
      ],
      "preferred_path": "Custom Hip Kernel",
      "wrapper_extension_target": "wrap_rotary_embedding",
      "fallback_path": "Custom Hip Kernel"
    }
  ],
  "output_requirements": {
    "must_include_fields": [
      "recommended_path",
      "closest_wrapper_or_extension_target",
      "rationale"
    ]
  }
}
