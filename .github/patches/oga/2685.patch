+        expected_logits[2] = expected_signal
+        params = og.GeneratorParams(model)
+        params.set_search_options(max_length=ids.shape[1] + 2, do_sample=False)
+        generator = og.Generator(model, params)
+        generator.set_inputs(inputs)
