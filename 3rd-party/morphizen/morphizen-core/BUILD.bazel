# Generated files that would normally be created by CMake custom commands
# Based on morphizen-core-static.cmake configuration

# Generate morphizen_version_info.hpp.inc (referenced in CMake)
genrule(
    name = "generate_version_info_hpp_inc",
    outs = ["morphizen_version_info.hpp.inc"],
    cmd = """
    echo '{"morphizen", "N/A", "N/A"},' > $@
    """,
)


# Generate config JSON binary (Python script equivalent)
# Note: This would normally run src/binary/config_json_binary.hpp.py with various parameters
py_binary(
    name = "config_json_binary_py",
    srcs = [
        "src/binary/config_json_binary.hpp.bazel.py",
    ],
    main = "src/binary/config_json_binary.hpp.bazel.py",
    deps = [
        "//tools:xxd",
    ],
)

label_flag(
    name = "label_morphizen_config.json",
    build_setting_default = "//morphizen-core:etc/morphizen_config.json",
)

genrule(
    name = "generate_morphizen_config_json",
    outs = [
        "config_json_binary.hpp",
        "morphizen_config.json",
    ],
    cmd = """
    $(location :config_json_binary_py) --in_morphizen_config_json $(location :label_morphizen_config.json) --out_morphizen_config_json $(location :morphizen_config.json) --morphizen_config_binary_hpp $(location :config_json_binary.hpp) --is_trim_config OFF --enable_default_config ON
    """,
    tools = [
        ":config_json_binary_py",
        ":label_morphizen_config.json",
    ],
)


# Main morphizen-core library (static)
# using glob is generally not considered a good practice in Bazel for several reasons:
#
# Build hermeticity: glob can pick up files that weren't intended to be part of the build, making builds non-deterministic
# Explicit dependencies: Bazel philosophy emphasizes explicit, declarative dependencies
# Build performance: glob requires filesystem scanning which can slow down builds
# Maintenance issues: When files are added/removed, the build behavior changes implicitly
cc_library(
    name = "morphizen-core-static",
    srcs = glob(
        [
            "src/*.cpp",
            "src/*.hpp",
            "src/binary/*.cpp",
            "src/binary/*.hpp",  # includes onnx_schema_json_binary.hpp (static file)
        ],
        exclude = [
            # Platform-specific files handled by select() below
            "src/util_mswin.cpp",
            "src/util_linux.cpp",
            "src/util_unknown.cpp",
            "src/mmap_file_win.cpp",
            "src/mmap_file_win.hpp",
            "src/mmap_file_tmphandle_win.cpp",
            "src/mmap_file_tmphandle_win.hpp",
            # Entry point, not part of the library
            "src/main.cpp",
        ],
    ) + select({
        "@bazel_tools//src/conditions:windows": [
            "src/mmap_file_win.cpp",
            "src/mmap_file_win.hpp",
            "src/mmap_file_tmphandle_win.cpp",
            "src/mmap_file_tmphandle_win.hpp",
            "src/util_mswin.cpp",
        ],
        "@bazel_tools//src/conditions:linux_x86_64": [
            "src/util_linux.cpp",
        ],
        "//conditions:default": [
            "src/util_unknown.cpp",
        ],
    }),
    hdrs = [
        ":config_json_binary.hpp",
        ":mem_binary_file.hpp.inc",
        "include/morphizen/tar.h",
        ":morphizen_version_info.hpp.inc",
    ],
    copts = select({
        "@bazel_tools//src/conditions:windows": [
            "/W0",  # Suppress all warnings
            "/DONNX_NAMESPACE=onnx",
            "/DMORPHIZEN_EXPORT_DLL=1",  # Allow internal headers (satisfies _sanity_check.hpp)
            "/UUNICODE",  # Undefine UNICODE (toolchain sets it; util_mswin.cpp uses LPCSTR)
            "/U_UNICODE",
            "/Zc:__cplusplus",
        ],
        "//conditions:default": [
            "-w",  # Suppress all warnings
            "-DONNX_NAMESPACE=onnx",
            "-DMORPHIZEN_EXPORT_DLL=1",
            "-fPIC",
        ],
    }),
    defines = [
        # Mirrors CMake: target_compile_definitions(morphizen-core-static PUBLIC MORPHIZEN_HAS_PATTERN_MATCHING=1)
        # Propagates transitively so all consumers (unit-test, ort-bridge/test, etc.) see Pattern APIs.
        "MORPHIZEN_HAS_PATTERN_MATCHING=1",
        # EP provider-option prefix name (the CMake build injects this via
        # add_compile_definitions). Propagates transitively so config_reader.cpp
        # (this target) and morphizen-ep.cpp (ort-bridge consumer) form `ep.<name>.`.
        r'MORPHIZEN_EP_REGISTRATION_NAME_LOWER=\"morphizenexecutionprovider\"',
    ],
    includes = [
        ".",  # For generated files in current directory
        "include",  # Public headers
        "src",  # Private implementation headers
        # Note: ONNXRuntime includes would be added by @onnxruntime//:onnxruntime_headers dependency
        # Note: ../3rd-party would be handled by external dependencies
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":morphizen-core-headers",
        ":morphizen-core-proto-headers",
        ":morphizen_proto_lib",
        "//morphizen-foundation",
        "//morphizen-graph:morphizen-graph",
        "//morphizen-pattern:morphizen-pattern",
        "//morphizen-utils:morphizen_utils",
        "//morphizen-ort-api-ext",
        "@hash-library//:hash-library",
        "@glog",
        "@gsl",
        "@onnx//:onnx",
        "@onnxruntime//:onnxruntime_headers",
        "@protobuf",
        "@zlib",
    ],
)

# Shared library (DLL) that ORT loads as the MorphiZen Execution Provider.
# Mirrors GHE's cc_binary(name="onnxruntime_vitisai_ep", linkshared=True).
# The unit-test and ort-bridge/test add this as a data dep so that
# Plugin::get("onnxruntime_morphizen_ep") can dynamically load it at runtime.
cc_binary(
    name = "onnxruntime_morphizen_ep",
    srcs = ["src/main.cpp"],
    linkshared = True,
    copts = select({
        "@bazel_tools//src/conditions:windows": [
            "/std:c++17",
            "/Zc:__cplusplus",
            "/DONNX_NAMESPACE=onnx",
            "/DMORPHIZEN_EXPORT_DLL=1",
        ],
        "//conditions:default": [
            "-std=c++17",
            "-fPIC",
            "-DONNX_NAMESPACE=onnx",
            "-DMORPHIZEN_EXPORT_DLL=1",
        ],
    }),
    # win_def_file is only meaningful on Windows; Bazel ignores it on Linux.
    # Use the _with_ort_bridge variant which also exports CreateEpFactories
    # and ReleaseEpFactory (required by ORT's RegisterExecutionProviderLibrary).
    win_def_file = ":onnxruntime_morphizen_ep_with_ort_bridge.def",
    visibility = ["//visibility:public"],
    deps = [
        ":morphizen-core-static",
        # ort-bridge provides CreateEpFactories and ReleaseEpFactory, which are
        # declared in the _with_ort_bridge.def and required by ORT's
        # RegisterExecutionProviderLibrary. Mirrors GHE vaip-core/BUILD.bazel.
        "//ort-bridge",
        # Mirrors CMake: morphizen-pass-init and morphizen-demo passes are
        # all linked with WHOLE_ARCHIVE into the EP DLL so their
        # StaticPluginRegister static initializers run at DLL load time.
        "//morphizen-pass-init:morphizen-pass-init",
        "//morphizen-demo/level-1-pass-relu-dq:morphizen-level1-pass-relu-dq",
        "//morphizen-demo/custom-op-relu-dq:morphizen-custom-op-relu-dq",
        "@glog",
        "@protobuf",
    ],
)

# Wraps the linkshared cc_binary so that adding it to a cc_test's deps causes
# Bazel to stage the DLL next to the test binary (Windows PATH search) and to
# add its directory to PATH, mirroring GHE's onnxruntime_vitisai_ep_runtime.
# Use in deps (not data) to get DLL-search-path propagation; add the raw
# cc_binary target to data as well so Rlocation resolves to an absolute path.
cc_import(
    name = "onnxruntime_morphizen_ep_runtime",
    shared_library = ":onnxruntime_morphizen_ep",
    visibility = ["//visibility:public"],
)

# Alias for backward compatibility
cc_library(
    name = "morphizen-core-headers",
    hdrs = glob(["include/morphizen/*.hpp", "include/morphizen/*.h"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
cc_library(
    name = "morphizen-core-proto-headers",
    hdrs = [":morphizen_proto_pb_h"],
    includes = ["."],  # exposes bazel-out/.../morphizen-core/ so morphizen/*.pb.h resolves
    visibility = ["//visibility:public"],
)
