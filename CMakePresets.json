{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 23,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "Morphizen Ninja",
            "description": "Default configuration for moprhizen",
            "generator": "Ninja",
            "binaryDir": "${env:VAI_RT_BUILD_DIR}/morphizen.ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
                "Protobuf_DEBUG": "ON",
                "BUILD_SHARED_LIBS": "OFF",
                "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_INSTALL_PREFIX": "${env:VAI_RT_PREFIX}",
                "CMAKE_PREFIX_PATH": "${env:VAI_RT_PREFIX}",
                "morphizen_ENABLE_ORT_BRIDGE": "ON",
                "morphizen_DEMO_DIR": "${sourceDir}/../morphizen-demo",
                "VAIP_JSON_CONFIG_FILE": "${sourceDir}/../morphizen-demo/etc/vaip_config.json",
                "morphizen_ENABLE_MLIR_BACKEND": "ON"
            }
        },
        {
            "name": "morphizen Visual Studio 2022 ",
            "displayName": "Visual Studio Professional 2022 Release - x86_arm64",
            "description": "Using compilers for Visual Studio 17 2022 (x86_arm64 architecture)",
            "generator": "Visual Studio 17 2022",
            "toolset": "host=x86",
            "architecture": "arm64",
            "binaryDir": "${env:VAI_RT_BUILD_DIR}/morphizen",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
                "Protobuf_DEBUG": "ON",
                "BUILD_SHARED_LIBS": "OFF",
                "CMAKE_POSITION_INDEPENDENT_CODE": "ON",
                "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo",
                "CMAKE_INSTALL_PREFIX": "${env:VAI_RT_PREFIX}",
                "CMAKE_PREFIX_PATH": "${env:VAI_RT_PREFIX}",
                "morphizen_ENABLE_ORT_BRIDGE": "ON",
                "morphizen_DEMO_DIR": "${sourceDir}/morphizen-demo",
                "VAIP_JSON_CONFIG_FILE": "${sourceDir}/morphizen-demo/etc/vaip_config.json",
                "morphizen_ENABLE_MLIR_BACKEND": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Build morphizen",
            "displayName": "Ninja - Debug",
            "configurePreset": "Morphizen Ninja",
            "configuration": "Debug",
            "jobs": 64
        }
    ],
    "testPresets": [
        {
            "name": "E2E simple",
            "configurePreset": "Morphizen Ninja",
            "configuration": "Debug",
            "description": "Run ",
            "displayName": "E2E simple",
            "filter": {
                "include": {
                    "name": "MorphizenE2ETestSuite/MorphizenE2ETest.RunE2ETests/single_session_gen_and_run_embed_ctx"
                }
            },
            "output": {
                "outputLogFile": "${sourceParentDir}/test_results.log",
                "verbosity": "extra"
            },
            "environment": {
                "DEBUG_LOG_LEVEL": "info",
                "XLNX_ONNX_EP_VERBOSE": "2",
                "VITISAI_EP_PROVIDER_OPTION_config_file": "not_exists",
                "VITISAI_EP_PROVIDER_OPTION_enable_cache_file_io_in_mem": "1",
                "MORPHIZEN_DEBUG_CONFIG_READER": "3"
            }
        },
        {
            "name": "Test07",
            "configurePreset": "Morphizen Ninja",
            "configuration": "Debug",
            "description": "run test 07",
            "displayName": "run test 07",
            "filter": {
                "include": {
                    "name": "VaipOrtApiTest.TestAll"
                }
            },
            "output": {
                "outputLogFile": "${sourceParentDir}/test_results.log"
            },
            "environment": {
                "MORPHIZEN_ORT_BRIDGE_UNITTEST_COVERAGE": "7"
            }
        }
    ]
}
