module(
    name = "onnx-hipdnn-ep",
    version = "1.0.0",
)

# Common dependencies needed by .bazelrc
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "bazel_cpp_toolchain", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# Build system dependencies
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_proto", version = "7.1.0")

# External dependencies for backend-mlir-compiler
bazel_dep(name = "glog", version = "0.7.1")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "flatbuffers", version = "25.12.19")

bazel_dep(name = "llvm-project-overlay", version = "22.1.3")
bazel_dep(name = "morphizen", version = "1.0")
local_path_override(
    module_name = "morphizen",
    path = "3rd-party/morphizen",
)
bazel_dep(name = "onnxruntime", version = "1.24.4")
bazel_dep(name = "googletest", version = "1.17.0")

# TheRock prebuilt ROCm SDK — required for real GPU builds (--config=real_runtime).
# In mock mode (default), GPU targets compile as empty stubs; no SDK headers needed.
# Provides: @therock//:hip_runtime, @therock//:hipdnn_backend, etc.
bazel_dep(name = "therock", version = "7.11.0")

# Python toolchain for hermetic builds.
# Must be 3.11+ on Windows: Python 3.10 uses CryptGenRandom (legacy CryptoAPI)
# which fails with NTE_PROVIDER_DLL_FAIL (0x8009001D) under restricted process
# tokens (e.g. RBE workers). Python 3.11+ uses BCryptGenRandom (CNG) instead.
# See: https://github.com/python/cpython/issues/88777 (bpo-44611)
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.11",
)

# Expose pre-built clang binaries (clang, llvm-link) for the bitcode pipeline.
toolchain_archives = use_extension(
    "@bazel_cpp_toolchain//toolchain/extensions:deps.bzl",
    "toolchain_archive_deps",
)
use_repo(toolchain_archives, "clang_linux", "clang_windows")
