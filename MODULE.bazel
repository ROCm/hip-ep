module(
    name = "onnx-hipdnn-ep",
    version = "1.0.0",
)

# Common dependencies needed by .bazelrc
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "bazel_cpp_toolchain", version = "0.1.0")

# Build system dependencies
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_proto", version = "7.1.0")

# External dependencies for backend-mlir-compiler
bazel_dep(name = "glog", version = "0.7.1")
bazel_dep(name = "protobuf", version = "33.4")

bazel_dep(name = "llvm-project-overlay", version = "22.1.3")
bazel_dep(name = "morphizen", version = "1.0")

# Python toolchain for hermetic builds
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.10",
)

# cmake: use hermetic cmake 3.31.8 from rules_foreign_cc.
# The tools extension creates cmake_3.31.8_toolchains but does not register it;
# we must use_repo + register_toolchains explicitly. cmake >= 3.25 resolves
# CMAKE_ROOT correctly in RBE sandbox layouts (3.23.2 was broken).
cmake_tools = use_extension("@rules_foreign_cc//foreign_cc:extensions.bzl", "tools")
use_repo(cmake_tools, "cmake_3.31.8_toolchains")
register_toolchains("@cmake_3.31.8_toolchains//:all")

# llvm-project: expose @llvm-project targets via the llvm-project-overlay module extension.
# Unlike openssl (which uses use_repo_rule), llvm-project-overlay uses a module extension
# that the root module must invoke to make @llvm-project visible.
llvm_repos = use_extension("@llvm-project-overlay//:llvm_repo.bzl", "llvm_extension")
use_repo(llvm_repos, "llvm-project")
