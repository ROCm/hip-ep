load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "morphizen-custom-op-mlir",
    srcs = [
        "src/plugin_registration.cpp",
        "src/MlirCustomOp.cpp",
        "src/InferenceState.cpp",
    ],
    hdrs = [
        "src/MlirCustomOp.h",
        "src/InferenceState.h",
        "src/custom_op_mlir.hpp",
    ],
    copts = select({
        "@platforms//os:windows": ["/std:c++17", "/W3"],
        "//conditions:default": ["-std=c++17", "-fPIC"],
    }),
    defines = ["MORPHIZEN_CUSTOM_OP=1"],  # Required for compilation
    includes = ["src"],
    alwayslink = True,  # CRITICAL: for plugin_registration.cpp
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "//backend-mlir-compiler/proto:mlir_compilation_proto",
        "//include:hip_headers",
        "//include:foundation_headers",
        "@glog//:glog",
        "@morphizen//morphizen-core:morphizen-core-static",
    ],
)
