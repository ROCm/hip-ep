load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@bazel_skylib//lib:selects.bzl", "selects")

package(default_visibility = ["//visibility:public"])

# Mock runtime flag (default: True — no GPU required for CI and local dev)
# Set to false with --//build_settings:mock_runtime=false to build the real
# GPU runtime (requires TheRock SDK and THEROCK_DIST env var).
# Convenience alias: --config=real_runtime (defined in .bazelrc)
bool_flag(
    name = "mock_runtime",
    build_setting_default = True,
)

# config_setting for select() expressions in BUILD files.
config_setting(
    name = "mock_runtime_true",
    flag_values = {":mock_runtime": "True"},
)

config_setting(
    name = "mock_runtime_false",
    flag_values = {":mock_runtime": "False"},
)
