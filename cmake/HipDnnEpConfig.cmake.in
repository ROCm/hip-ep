#
# onnx-hipdnn-ep package config for consumers of a PREBUILT install tree.
#
#   find_package(HipDnnEp CONFIG REQUIRED)   # -DHipDnnEp_DIR=<prefix>/lib/cmake/HipDnnEp
#
# Provides:
#   HipDnnEp::hip-compiler   - IMPORTED executable: the ONNX MLIR -> LLVM/native
#                              compiler CLI.
#   HipDnnEp::hip-mlir-opt   - IMPORTED executable: the MLIR pass driver.
#   HipDnnEp::plugin_headers - INTERFACE target carrying the public plugin-surface
#                              include dir (hip/Compiler/PluginAPI.h,
#                              PluginRegistry.h), for inspecting the surface.
#
# NOTE: this config is NOT how you build a compiler plugin. Plugins are linked
# STATICALLY into the host (see docs/design/plugin-interface.md, "Linkage
# model"): a plugin is a static library that defines `hipEpRegisterPlugin_<id>`
# and is CO-BUILT into onnx-hipdnn-ep -- add its directory with
# -DHIPDNN_EP_COMPILER_PLUGIN_PATHS=<dir> and select it with
# -DHIPDNN_EP_COMPILER_PLUGINS=<id>. In that (supported) flow the plugin gets
# the surface headers and MLIR toolchain from the host build directly and does
# not use this package config. The build-time MLIR_DIR / LLVM_DIR are recorded
# below as convenience hints.
set(HipDnnEp_MLIR_DIR_HINT "@MLIR_DIR@")
set(HipDnnEp_LLVM_DIR_HINT "@LLVM_DIR@")

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/HipDnnEpTargets.cmake")

check_required_components(HipDnnEp)
