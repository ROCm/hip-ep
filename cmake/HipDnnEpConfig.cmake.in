#
# onnx-hipdnn-ep plugin SDK package config.
#
# Consumed by a downstream plugin via:
#   find_package(HipDnnEp CONFIG REQUIRED)   # -DHipDnnEp_DIR=<prefix>/lib/cmake/HipDnnEp
#
# Provides:
#   HipDnnEp::plugin_headers - INTERFACE target carrying the public include dir
#                              (hip/Compiler/PluginAPI.h, PluginRegistry.h).
#   HipDnnEp::hip-compiler   - IMPORTED executable: the ONNX MLIR -> LLVM/native
#                              compiler CLI.
#   HipDnnEp::hip-mlir-opt   - IMPORTED executable: the MLIR pass driver.
#
# Linkage model: compiler plugins are linked STATICALLY (see
# docs/design/plugin-interface.md, "Linkage model"). A plugin builds a static
# library that defines `hipEpRegisterPlugin_<id>` and is linked into the host at
# configure time via -DHIPDNN_EP_COMPILER_PLUGINS=<id>. Because plugins and host
# share one binary (and one GPU-arch / kernel build), a downstream builds
# onnx-hipdnn-ep itself and adds its plugin to that build -- there is no
# dlopen and no symbol export.
#
# A plugin TU compiles against HipDnnEp::plugin_headers for the plugin surface
# and ALSO needs MLIR headers (for mlir::PassRegistration<> etc.). MLIR is
# intentionally NOT re-exported here: call find_package(MLIR CONFIG) yourself
# against the SAME MLIR build the tools were compiled with, and link the plugin
# to MLIR HEADERS ONLY (do NOT link the MLIR libraries -- the plugin's MLIR
# symbols stay undefined in the static lib and resolve at the final host link;
# see docs/plugin_authoring.md). The build-time MLIR_DIR / LLVM_DIR are recorded
# below as convenience hints.
set(HipDnnEp_MLIR_DIR_HINT "@MLIR_DIR@")
set(HipDnnEp_LLVM_DIR_HINT "@LLVM_DIR@")

@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/HipDnnEpTargets.cmake")

check_required_components(HipDnnEp)
