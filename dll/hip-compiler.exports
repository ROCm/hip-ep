# Linker version script for libhip-compiler.so (Linux).
#
# Only the C API entry points are exported. Everything else -- in particular
# the statically-linked LLVM/MLIR/clang symbols pulled in via HipCInterface --
# is localized so it never lands in the global dynamic symbol table.
#
# Why this matters: ROCm's libamd_comgr.so resolves ~820 *undefined*,
# version-tagged (@LLVM_22.0) llvm:: symbols at runtime from its own
# libLLVM.so.22.0git. If our shared library exports the same (unversioned,
# upstream-LLVM-22.1, ABI-incompatible) symbols into the flat global scope,
# comgr's references bind to ours instead, and comgr's in-process device-code
# compile (HIP runtime kernel JIT) segfaults. Localizing keeps comgr bound to
# its own LLVM. Windows is naturally immune (PE does not export by default).
{
  global:
    hip_compile_with_fs;
    hip_get_version;
  local:
    *;
};
