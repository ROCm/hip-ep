{
  "passes": [
    {
      "name": "init",
      "plugin": "morphizen-pass-init"
    },
    {
      "name": "fuse_ROCm",
      "plugin": "morphizen-level1-pass-rocm",
      "passGenericParam": {
        "subPassNames": [
          "morphizen-level2-pass-rocm-conv",
          "morphizen-level2-pass-rocm-gemm",
          "morphizen-level2-pass-rocm-matmul",
          "morphizen-level2-pass-rocm-reshape",
          "morphizen-level2-pass-rocm-transpose",
          "morphizen-level2-pass-rocm-tile",
          "morphizen-level2-pass-rocm-mul",
          "morphizen-level2-pass-rocm-softmax",
          "morphizen-level2-pass-rocm-gqa"
        ]
      }
    }
  ],
  "target": "ROCm_default",
  "targets": [
    {
      "name": "ROCm_default",
      "pass": [
        "init",
        "fuse_ROCm"
      ],
      "provider_options": {
        "pass.init.enable_dump": "0",
        "pass.init.directory": "morphizen_init",
        "pass.init.filename": "init-graph-for-rocm.onnx"
      }
    }
  ]
}
