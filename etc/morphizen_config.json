{
  "passes": [
    {
      "name": "init",
      "plugin": "morphizen-pass-init"
    },
    {
      "name": "mlir-pass",
      "plugin": "morphizen-level1-pass-mlir-compiler"
    }
  ],
  "target": "mlir-target",
  "targets": [
    {
      "name": "mlir-target",
