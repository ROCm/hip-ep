{
  "provider_options": {
    "enable_cache_file_io_in_mem": "0",
    "cache_dir": "rocm_cache"
  },
  "passes": [
    {
      "name": "init",
      "plugin": "vaip-pass_init"
    },
    {
      "name": "fuse_ROCm",
      "plugin": "morphizen-level1-pass-rocm",
      "passGenericParam": {
        "subPassNames": [
          "morphizen-level2-pass-rocm-conv",
          "morphizen-level2-pass-rocm-gemm"
        ]
      }
    }
  ],
  "target": "ROCm_default",
  "targets": [
    {
      "name": "ROCm_default",
      "pass": [
        "init",
        "fuse_ROCm"
      ]
    }
  ]
}
