load("@rules_cc//cc:defs.bzl", "cc_library")
load("@llvm-project-overlay//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")

# Public headers for the HIP IR dialect (.h files).
# includes = ["../../../../include"] makes include/ the search root so that
# #include "hip/Dialect/IR/HipDialect.h" resolves correctly for dependents.
cc_library(
    name = "hip_dialect_ir_headers",
    hdrs = glob(["*.h"]),
    includes = ["../../../../include"],  # workspace-relative: include/
    visibility = ["//visibility:public"],
)

# td_library for the HIP IR .td files (dialect + types + ops).
# The include root is //include so that `include "hip/Dialect/IR/..."` resolves.
td_library(
    name = "HipIRTdFiles",
    srcs = [
        "HipDialect.td",
        "HipOps.td",
        "HipTypes.td",
    ],
    includes = ["../../../../include"],  # workspace-relative: include/
    deps = [
        "@llvm-project-overlay//mlir:DestinationStyleOpInterfaceTdFiles",
        "@llvm-project-overlay//mlir:OpBaseTdFiles",
        "@llvm-project-overlay//mlir:SideEffectInterfacesTdFiles",
    ],
    visibility = ["//visibility:public"],
)

# Dialect declarations/definitions
gentbl_cc_library(
    name = "HipDialectIncGen",
    tblgen = "@llvm-project-overlay//mlir:mlir-tblgen",
    td_file = "HipDialect.td",
    tbl_outs = {
        "HipDialect.h.inc": ["-gen-dialect-decls", "-dialect=hip"],
        "HipDialect.cpp.inc": ["-gen-dialect-defs", "-dialect=hip"],
    },
    deps = [":HipIRTdFiles"],
    visibility = ["//visibility:public"],
)

# Type declarations/definitions
gentbl_cc_library(
    name = "HipTypesIncGen",
    tblgen = "@llvm-project-overlay//mlir:mlir-tblgen",
    td_file = "HipTypes.td",
    tbl_outs = {
        "HipTypes.h.inc": ["-gen-typedef-decls", "-typedefs-dialect=hip"],
        "HipTypes.cpp.inc": ["-gen-typedef-defs", "-typedefs-dialect=hip"],
    },
    deps = [":HipIRTdFiles"],
    visibility = ["//visibility:public"],
)

# Op declarations/definitions
gentbl_cc_library(
    name = "HipOpsIncGen",
    tblgen = "@llvm-project-overlay//mlir:mlir-tblgen",
    td_file = "HipOps.td",
    tbl_outs = {
        "HipOps.h.inc": ["-gen-op-decls"],
        "HipOps.cpp.inc": ["-gen-op-defs"],
    },
    deps = [":HipIRTdFiles"],
    visibility = ["//visibility:public"],
)
