load("@rules_cc//cc:defs.bzl", "cc_library")
load("@llvm-project-overlay//mlir:tblgen.bzl", "gentbl_cc_library", "td_library")

# Public headers for the HIP Transforms dialect passes (.h files).
# includes = ["../../../../include"] makes include/ the search root.
cc_library(
    name = "hip_dialect_transforms_headers",
    hdrs = glob(["*.h"]),
    includes = ["../../../../include"],  # workspace-relative: include/
    visibility = ["//visibility:public"],
)

# td_library for Passes.td.
# The include root is //include so that `include "hip/Dialect/IR/..."` resolves.
td_library(
    name = "HipPassesTdFiles",
    srcs = ["Passes.td"],
    includes = ["../../../../include"],  # workspace-relative: include/
    deps = [
        "//include/hip/Dialect/IR:HipIRTdFiles",
        "@llvm-project-overlay//mlir:PassBaseTdFiles",
    ],
    visibility = ["//visibility:public"],
)

# Pass declarations (Passes.h.inc)
gentbl_cc_library(
    name = "HipPassesIncGen",
    tblgen = "@llvm-project-overlay//mlir:mlir-tblgen",
    td_file = "Passes.td",
    tbl_outs = {
        "Passes.h.inc": ["-gen-pass-decls", "-name=Hip"],
    },
    deps = [":HipPassesTdFiles"],
    visibility = ["//visibility:public"],
)
