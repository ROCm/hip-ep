//===- QDQMatMulFusion.pdll -----------------------------------------------===//
//
// PDLL patterns for QDQ MatMul fusion - pure PDLL approach.
//
// Included by HipFusionPatterns.pdll, which declares the native constraints
// used below. Not compilable on its own.
//
// The B edge comes in three shapes that hip.qmatmul spells differently, so
// each gets its own pattern:
//
//   per-tensor      scale and zero point fold into attributes
//   per-column W4   they stay operands, `packed_int4` marks the value width
//   per-column W8   they stay operands, no marker
//
// PDL's match section is a pure conjunction with no `or`, and a constraint
// that returns a result cannot be shared by two patterns rooted at the same op
// (the PDL module then fails to lower with "operand does not dominate this
// use"), so the split is into independent patterns whose match sections use
// only result-free constraints.
//
// All three root at the same onnx.QuantizeLinear. The two per-column ones are
// mutually exclusive -- a weight cannot have both byte counts -- but a weight
// that somehow satisfied per-tensor as well would be better served by the
// folded coefficient, so the benefits order per-tensor first rather than
// leaving that tie to pattern insertion order.
//===----------------------------------------------------------------------===//

// ===== Per-tensor B: scale and zero point fold into attributes =====
Pattern QDQMatMul with benefit(10) {
  // Match the QDQ chain:
  //   DequantizeLinear, DequantizeLinear -> MatMul -> QuantizeLinear
  //
  // ONNX makes zero_point optional on both Q and DQ, so a trailing ValueRange
  // absorbs the 2-operand and 3-operand forms with one pattern.
  let dq_a = op<onnx.DequantizeLinear>(a: Value, a_scale: Value, a_tail: ValueRange);
  let dq_b = op<onnx.DequantizeLinear>(b: Value, b_scale: Value, b_tail: ValueRange);

  // Currently, we support A16W8 and A8W8. A16W16 requires a higher-bit-width
  // accumulator and therefore an additional kernel implementation, so we will
  // not add support for it for now.
  IsEightOrSixteenBitQuantized(dq_a);
  IsEightBitQuantized(dq_b);

  let matmul = op<onnx.MatMul>(dq_a.0, dq_b.0);

  let quant = op<onnx.QuantizeLinear>(matmul.0, y_scale: Value, y_tail: ValueRange) -> (y_type: Type);
  IsEightOrSixteenBitQuantized(quant);

  // The rewrite below builds its DPS init with a bare `tensor.empty`, which
  // only verifies for a static result type.
  HasStaticShapedResults(quant);

  // Fusability only: every scale must be a per-tensor splat constant and every
  // zero point must be readable (or absent, which means zero).
  HasContextArg(quant);
  IsSplatConstantValue(a_scale);
  IsSplatConstantValue(b_scale);
  IsSplatConstantValue(y_scale);
  HasExtractableZeropoint(dq_a, attr<"2 : i64">);
  HasExtractableZeropoint(dq_b, attr<"2 : i64">);
  HasExtractableZeropoint(quant, attr<"2 : i64">);

  // Root on the chain tail so the output type is available for tensor.empty.
  rewrite quant with {
    let ctx = GetContextArg(quant);
    let a_scale_attr = ExtractScaleValue(a_scale);
    let b_scale_attr = ExtractScaleValue(b_scale);
    let y_scale_attr = ExtractScaleValue(y_scale);
    let a_zeropoint_attr = ExtractZeropointValue(dq_a, attr<"2 : i64">, attr<"0 : i64">);
    let b_zeropoint_attr = ExtractZeropointValue(dq_b, attr<"2 : i64">, attr<"0 : i64">);
    let y_zeropoint_attr = ExtractZeropointValue(quant, attr<"2 : i64">, attr<"0 : i64">);

    // TransposeMatMulFold stamps hipdnn.transA / hipdnn.transB onto
    // onnx.MatMul, so hip.qmatmul carries them through even though nothing
    // reaches this pattern with a non-zero stamp today.
    let trans_a_attr = ExtractAttrInt64(matmul, attr<"\"hipdnn.transA\"">, attr<"0 : i64">);
    let trans_b_attr = ExtractAttrInt64(matmul, attr<"\"hipdnn.transB\"">, attr<"0 : i64">);

    let empty = op<tensor.empty> -> (y_type);
    let qmatmul = op<hip.qmatmul>(ctx, a, b, empty.0) {
      A_scale = a_scale_attr,
      A_zero_point = a_zeropoint_attr,
      B_scale = b_scale_attr,
      B_zero_point = b_zeropoint_attr,
      Y_scale = y_scale_attr,
      Y_zero_point = y_zeropoint_attr,
      transA = trans_a_attr,
      transB = trans_b_attr
    } -> (y_type);
    replace quant with qmatmul;
  };
}

// ===== Per-output-column B, packed 4-bit =====
//
// Unlike the per-tensor pattern, the weight scale and zero point hold one
// value per column and arrive as external constants whose bytes are not in the
// IR, so there is nothing to fold -- the kernel has to index them by column,
// exactly as in the qconv pattern.
Pattern QDQMatMulPerColumnW4 with benefit(9) {
  let dq_a = op<onnx.DequantizeLinear>(a: Value, a_scale: Value, a_tail: ValueRange);
  // All three operands are bound: the per-column form passes the weight scale
  // and zero point straight through to hip.qmatmul.
  let dq_b = op<onnx.DequantizeLinear>(b: Value, b_scales: Value, b_zero_points: Value);

  IsEightOrSixteenBitQuantized(dq_a);
  IsPerAxisQuantizedWeight(dq_b, attr<"2 : i64">, attr<"1 : i64">, attr<"4 : i64">);

  let matmul = op<onnx.MatMul>(dq_a.0, dq_b.0);
  HasAttrInt64Equal(matmul, attr<"\"hipdnn.transB\"">, attr<"0 : i64">, attr<"0 : i64">);

  let quant = op<onnx.QuantizeLinear>(matmul.0, y_scale: Value, y_tail: ValueRange) -> (y_type: Type);
  IsEightOrSixteenBitQuantized(quant);
  HasStaticShapedResults(quant);

  // Activation and result quantization must be per-tensor for their scales to
  // fold into a single coefficient; the weight side is deliberately exempt.
  HasContextArg(quant);
  IsSplatConstantValue(a_scale);
  IsSplatConstantValue(y_scale);
  HasExtractableZeropoint(dq_a, attr<"2 : i64">);
  HasExtractableZeropoint(quant, attr<"2 : i64">);

  rewrite quant with {
    let ctx = GetContextArg(quant);
    let a_scale_attr = ExtractScaleValue(a_scale);
    let y_scale_attr = ExtractScaleValue(y_scale);
    let a_zeropoint_attr = ExtractZeropointValue(dq_a, attr<"2 : i64">, attr<"0 : i64">);
    let y_zeropoint_attr = ExtractZeropointValue(quant, attr<"2 : i64">, attr<"0 : i64">);
    // transA acts on the activation only, so a folded Transpose there is still
    // fusable; transB is pinned to 0 by the constraint above.
    let trans_a_attr = ExtractAttrInt64(matmul, attr<"\"hipdnn.transA\"">, attr<"0 : i64">);

    let empty = op<tensor.empty> -> (y_type);
    let qmatmul = op<hip.qmatmul>(ctx, a, b, b_scales, b_zero_points, empty.0) {
      A_scale = a_scale_attr,
      A_zero_point = a_zeropoint_attr,
      Y_scale = y_scale_attr,
      Y_zero_point = y_zeropoint_attr,
      transA = trans_a_attr,
      transB = attr<"0 : i64">,
      B_quant_axis = attr<"1 : i64">,
      packed_int4 = attr<"unit">
    } -> (y_type);
    replace quant with qmatmul;
  };
}

// ===== Per-output-column B, full-width 8-bit =====
//
// The W4 pattern above with the storage width swapped and the `packed_int4`
// marker dropped; everything the compiler does is otherwise identical, which
// is why this is a copy rather than a shared helper -- the two differ only in
// what a PDLL `op<>` literal cannot make conditional.
//
// The widths part ways in the kernel, not here. A 4-bit weight has its column
// zero point subtracted while its nibble is widened, which is free and makes
// the rowA correction vanish; an 8-bit weight cannot, because B - z_b reaches
// +-255 and would not fit the dot4 operand, so it keeps the raw weight and
// pays for the per-column zero point in the epilogue instead. Both stay on
// dot4. b_bits, which the lowering derives from `packed_int4`, is what tells
// the runtime which one it is.
Pattern QDQMatMulPerColumnW8 with benefit(9) {
  let dq_a = op<onnx.DequantizeLinear>(a: Value, a_scale: Value, a_tail: ValueRange);
  let dq_b = op<onnx.DequantizeLinear>(b: Value, b_scales: Value, b_zero_points: Value);

  IsEightOrSixteenBitQuantized(dq_a);
  IsPerAxisQuantizedWeight(dq_b, attr<"2 : i64">, attr<"1 : i64">, attr<"8 : i64">);

  let matmul = op<onnx.MatMul>(dq_a.0, dq_b.0);
  HasAttrInt64Equal(matmul, attr<"\"hipdnn.transB\"">, attr<"0 : i64">, attr<"0 : i64">);

  let quant = op<onnx.QuantizeLinear>(matmul.0, y_scale: Value, y_tail: ValueRange) -> (y_type: Type);
  IsEightOrSixteenBitQuantized(quant);
  HasStaticShapedResults(quant);

  HasContextArg(quant);
  IsSplatConstantValue(a_scale);
  IsSplatConstantValue(y_scale);
  HasExtractableZeropoint(dq_a, attr<"2 : i64">);
  HasExtractableZeropoint(quant, attr<"2 : i64">);

  rewrite quant with {
    let ctx = GetContextArg(quant);
    let a_scale_attr = ExtractScaleValue(a_scale);
    let y_scale_attr = ExtractScaleValue(y_scale);
    let a_zeropoint_attr = ExtractZeropointValue(dq_a, attr<"2 : i64">, attr<"0 : i64">);
    let y_zeropoint_attr = ExtractZeropointValue(quant, attr<"2 : i64">, attr<"0 : i64">);
    let trans_a_attr = ExtractAttrInt64(matmul, attr<"\"hipdnn.transA\"">, attr<"0 : i64">);

    let empty = op<tensor.empty> -> (y_type);
    let qmatmul = op<hip.qmatmul>(ctx, a, b, b_scales, b_zero_points, empty.0) {
      A_scale = a_scale_attr,
      A_zero_point = a_zeropoint_attr,
      Y_scale = y_scale_attr,
      Y_zero_point = y_zeropoint_attr,
      transA = trans_a_attr,
      transB = attr<"0 : i64">,
      B_quant_axis = attr<"1 : i64">
    } -> (y_type);
    replace quant with qmatmul;
  };
}
