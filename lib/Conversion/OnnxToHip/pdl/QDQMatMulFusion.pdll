//===- QDQMatMulFusion.pdll -----------------------------------------------===//
//
// PDLL pattern for QDQ MatMul fusion.
//
// This pattern MARKS operations with attributes.
// The C++ conversion pass reads these attributes and performs the fusion.
//
//===----------------------------------------------------------------------===//

// Native rewrite: mark root op with fusion attribute
// Implemented in QDQMatMulFusion.cpp via registerRewriteFunction
Rewrite markQDQFusion(root: Op, name: Attr);

// Pattern: Mark QDQ MatMul sequence for fusion
Pattern QDQMatMulFusion with benefit(10) {
  // Match the chain: QuantizeLinear -> MatMul -> DequantizeLinear
  let quant = op<onnx.QuantizeLinear>(lhs: Value, lhs_scale: Value, lhs_zp: Value);
  let matmul = op<onnx.MatMul>(quant.0, rhs: Value);
  let dequant = op<onnx.DequantizeLinear>(matmul.0, out_scale: Value, out_zp: Value);
  
  // Mark the root (DequantizeLinear) for fusion
  rewrite dequant with {
    markQDQFusion(dequant, attr<"\"qdq_matmul\"">);
  };
}
