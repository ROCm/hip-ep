//===- QdqToQuantTypes.pdll -----------------------------------------------===//
//
// Fold the Q/DQ around a hip op into the op's element types. The result is the
// same op as in a float model, only with `!quant.uniform` types, so later
// fusions are written once for both. The types select the kernel at lowering.
//
// Included by HipFusionTransformPatterns.pdll, which declares the native
// helpers used below. Not compilable on its own.
//===----------------------------------------------------------------------===//

Pattern HipAddQdqToQuantTypes with benefit(10) {
  // dequantize x2 -> hip.add -> quantize. The trailing ValueRanges absorb the
  // optional zero point and the init.
  let dq_lhs = op<hip.dequantize_linear>(ctx: Value, lhs: Value, _: ValueRange);
  let dq_rhs = op<hip.dequantize_linear>(ctx, rhs: Value, _: ValueRange);
  let add = op<hip.add>(ctx, dq_lhs.0, dq_rhs.0, add_init: Value);
  let q = op<hip.quantize_linear>(ctx, add.0, _: ValueRange)
      -> (output_type: Type);

  // Each Q/DQ has a per-tensor quant type and a kernel takes the combination.
  SupportsQuantTypes(add, dq_lhs, dq_rhs, q);
  // A second user of the float sum would keep the float add alive.
  HasSingleUseResult(add);

  rewrite q with {
    let lhs_type = GetQuantTensorType(dq_lhs);
    let rhs_type = GetQuantTensorType(dq_rhs);
    let out_type = GetQuantTensorType(q);

    let lhs_q = op<hip.storage_cast>(lhs) -> (lhs_type);
    let rhs_q = op<hip.storage_cast>(rhs) -> (rhs_type);
    let init = BuildInit(out_type, add_init);
    let qadd = op<hip.add>(ctx, lhs_q, rhs_q, init) -> (out_type);
    let out = op<hip.storage_cast>(qadd) -> (output_type);
    replace q with out;
  };
}

// Gemm and matmul fold the same way. Only per-tensor Q/DQ become types: a
// per-column weight has file-backed scales that cannot be type parameters, and
// a packed 4-bit weight is not one value per element; both stay on
// QMatMulFusion.pdll / QGemmFusion.pdll.
Pattern HipMatmulQdqToQuantTypes with benefit(10) {
  let dq_a = op<hip.dequantize_linear>(ctx: Value, a: Value, _: ValueRange);
  let dq_b = op<hip.dequantize_linear>(ctx, b: Value, _: ValueRange);
  let matmul = op<hip.matmul>(ctx, dq_a.0, dq_b.0, matmul_init: Value);
  let q = op<hip.quantize_linear>(ctx, matmul.0, _: ValueRange)
      -> (output_type: Type);

  SupportsQuantTypes(matmul, dq_a, dq_b, q);
  HasSingleUseResult(matmul);

  rewrite q with {
    let a_type = GetQuantTensorType(dq_a);
    let b_type = GetQuantTensorType(dq_b);
    let out_type = GetQuantTensorType(q);
    let trans_a_attr =
        ExtractHipIntAttr(matmul, attr<"\"transA\"">, attr<"0 : i64">);
    let trans_b_attr =
        ExtractHipIntAttr(matmul, attr<"\"transB\"">, attr<"0 : i64">);

    let a_q = op<hip.storage_cast>(a) -> (a_type);
    let b_q = op<hip.storage_cast>(b) -> (b_type);
    let init = BuildInit(out_type, matmul_init);
    let qmatmul = op<hip.matmul>(ctx, a_q, b_q, init) {
      transA = trans_a_attr,
      transB = trans_b_attr
    } -> (out_type);
    let out = op<hip.storage_cast>(qmatmul) -> (output_type);
    replace q with out;
  };
}

// A matmul with a bias (from GemmToMatmul) folds like a gemm with C.
Pattern HipMatmulBiasQdqToQuantTypes with benefit(10) {
  let dq_a = op<hip.dequantize_linear>(ctx: Value, a: Value, _: ValueRange);
  let dq_b = op<hip.dequantize_linear>(ctx, b: Value, _: ValueRange);
  let dq_c = op<hip.dequantize_linear>(ctx, c: Value, _: ValueRange);
  let matmul = op<hip.matmul>(ctx, dq_a.0, dq_b.0, dq_c.0, matmul_init: Value);
  let q = op<hip.quantize_linear>(ctx, matmul.0, _: ValueRange)
      -> (output_type: Type);

  SupportsQuantTypesWithBias(matmul, dq_a, dq_b, dq_c, q);
  HasSingleUseResult(matmul);

  rewrite q with {
    let a_type = GetQuantTensorType(dq_a);
    let b_type = GetQuantTensorType(dq_b);
    let c_type = GetQuantTensorType(dq_c);
    let out_type = GetQuantTensorType(q);
    let trans_a_attr =
        ExtractHipIntAttr(matmul, attr<"\"transA\"">, attr<"0 : i64">);
    let trans_b_attr =
        ExtractHipIntAttr(matmul, attr<"\"transB\"">, attr<"0 : i64">);

    let a_q = op<hip.storage_cast>(a) -> (a_type);
    let b_q = op<hip.storage_cast>(b) -> (b_type);
    let c_q = op<hip.storage_cast>(c) -> (c_type);
    let init = BuildInit(out_type, matmul_init);
    let qmatmul = op<hip.matmul>(ctx, a_q, b_q, c_q, init) {
      transA = trans_a_attr,
      transB = trans_b_attr
    } -> (out_type);
    let out = op<hip.storage_cast>(qmatmul) -> (output_type);
    replace q with out;
  };
}

// Gemms GemmToMatmul keeps (alpha or beta != 1, a non-row C).
Pattern HipGemmQdqToQuantTypes with benefit(10) {
  let dq_a = op<hip.dequantize_linear>(ctx: Value, a: Value, _: ValueRange);
  let dq_b = op<hip.dequantize_linear>(ctx, b: Value, _: ValueRange);
  let dq_c = op<hip.dequantize_linear>(ctx, c: Value, _: ValueRange);
  let gemm = op<hip.gemm>(ctx, dq_a.0, dq_b.0, dq_c.0, gemm_init: Value);
  let q = op<hip.quantize_linear>(ctx, gemm.0, _: ValueRange)
      -> (output_type: Type);

  SupportsQuantTypesWithBias(gemm, dq_a, dq_b, dq_c, q);
  HasSingleUseResult(gemm);

  rewrite q with {
    let a_type = GetQuantTensorType(dq_a);
    let b_type = GetQuantTensorType(dq_b);
    let c_type = GetQuantTensorType(dq_c);
    let out_type = GetQuantTensorType(q);
    let alpha_attr =
        ExtractHipFloatAttr(gemm, attr<"\"alpha\"">, attr<"1.0 : f32">);
    let beta_attr =
        ExtractHipFloatAttr(gemm, attr<"\"beta\"">, attr<"1.0 : f32">);
    let trans_a_attr =
        ExtractHipIntAttr(gemm, attr<"\"transA\"">, attr<"0 : i64">);
    let trans_b_attr =
        ExtractHipIntAttr(gemm, attr<"\"transB\"">, attr<"0 : i64">);

    let a_q = op<hip.storage_cast>(a) -> (a_type);
    let b_q = op<hip.storage_cast>(b) -> (b_type);
    let c_q = op<hip.storage_cast>(c) -> (c_type);
    let init = BuildInit(out_type, gemm_init);
    let qgemm = op<hip.gemm>(ctx, a_q, b_q, c_q, init) {
      alpha = alpha_attr,
      beta = beta_attr,
      transA = trans_a_attr,
      transB = trans_b_attr
    } -> (out_type);
    let out = op<hip.storage_cast>(qgemm) -> (output_type);
    replace q with out;
  };
}

Pattern HipGemmNoBiasQdqToQuantTypes with benefit(10) {
  let dq_a = op<hip.dequantize_linear>(ctx: Value, a: Value, _: ValueRange);
  let dq_b = op<hip.dequantize_linear>(ctx, b: Value, _: ValueRange);
  let gemm = op<hip.gemm>(ctx, dq_a.0, dq_b.0, gemm_init: Value);
  let q = op<hip.quantize_linear>(ctx, gemm.0, _: ValueRange)
      -> (output_type: Type);

  SupportsQuantTypes(gemm, dq_a, dq_b, q);
  HasSingleUseResult(gemm);

  rewrite q with {
    let a_type = GetQuantTensorType(dq_a);
    let b_type = GetQuantTensorType(dq_b);
    let out_type = GetQuantTensorType(q);
    let alpha_attr =
        ExtractHipFloatAttr(gemm, attr<"\"alpha\"">, attr<"1.0 : f32">);
    let trans_a_attr =
        ExtractHipIntAttr(gemm, attr<"\"transA\"">, attr<"0 : i64">);
    let trans_b_attr =
        ExtractHipIntAttr(gemm, attr<"\"transB\"">, attr<"0 : i64">);

    let a_q = op<hip.storage_cast>(a) -> (a_type);
    let b_q = op<hip.storage_cast>(b) -> (b_type);
    let init = BuildInit(out_type, gemm_init);
    let qgemm = op<hip.gemm>(ctx, a_q, b_q, init) {
      alpha = alpha_attr,
      transA = trans_a_attr,
      transB = trans_b_attr
    } -> (out_type);
    let out = op<hip.storage_cast>(qgemm) -> (output_type);
    replace q with out;
  };
}
