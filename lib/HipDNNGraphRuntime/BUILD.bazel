load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")

# hipdnn_graph_runtime — real GPU only (requires TheRock hipDNN SDK).
# Only built when --//build_settings:mock_runtime=false (--config=real_runtime).
#
# Produces hipdnn_graph_runtime.dll/.so — a shared library loaded at runtime
# by the generated DLL for hipDNN graph execution.

cc_library(
    name = "hipdnn_graph_runtime_lib",
    srcs = ["hipdnn_graph_runtime.cpp"],
    hdrs = ["hipdnn_graph_runtime.h"],
    local_defines = [
        "HIPDNN_GRAPH_RUNTIME_EXPORTS",
        "__HIP_PLATFORM_AMD__",
        "HIP_INCLUDE_HIP_HIP_VECTOR_TYPES_H",
        "HIP_INCLUDE_HIP_AMD_DETAIL_CHANNEL_DESCRIPTOR_H",
        "HIP_INCLUDE_HIP_AMD_DETAIL_HIP_VECTOR_TYPES_H",
    ],
    copts = select({
        "@platforms//os:windows": ["/GR", "/permissive"],
        "//conditions:default": ["-frtti"],
    }),
    deps = [
        "//lib/HipDNNGraph:HipDNNGraph",
        "@therock//:hipdnn_backend",
        "@therock//:hip_runtime",
    ],
)

cc_shared_library(
    name = "hipdnn_graph_runtime",
    shared_lib_name = select({
        "@platforms//os:windows": "hipdnn_graph_runtime.dll",
        "//conditions:default": "libhipdnn_graph_runtime.so",
    }),
    roots = [":hipdnn_graph_runtime_lib"],
    visibility = ["//visibility:public"],
)
