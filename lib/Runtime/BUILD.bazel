load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")
load(":compile_to_bc.bzl", "compile_to_bc")

# ============================================================================
# Runtime bitcode pipeline (mock and real runtime)
# ============================================================================
# Mirrors CMakeLists.txt: compile .cpp → .bc via clang -emit-llvm,
# llvm-link → runtime.bc, make_runtime_ir_data.py → runtime_ir_data.cpp,
# wrap in cc_library (HipRuntimeBitcode).
#
# Mock mode  (default, --//build_settings:mock_runtime=true):
#   Compiles mock/ stubs — no GPU SDK required.
#
# Real mode  (--config=real_runtime i.e. --//build_settings:mock_runtime=false):
#   Compiles real/ GPU implementations.
#   Requires @therock SDK (fetched by Bazel module system automatically).
# ============================================================================

py_binary(
    name = "xxd_py",
    srcs = ["//cmake:xxd.py"],
    main = "//cmake:xxd.py",
)

# Combined xxd + extern-C transform + size append in one Python script.
# Replaces the two-step CMake pipeline in lib/Target/LLVM/CMakeLists.txt.
py_binary(
    name = "make_runtime_ir_data",
    srcs = ["make_runtime_ir_data.py"],
    main = "make_runtime_ir_data.py",
)

# Header library — top-level headers shared by both mock and real.
# Mode-specific subdirectory headers (mock/*.h or real/*.h) are added via select().
cc_library(
    name = "runtime_headers",
    hdrs = glob(["*.h"]) + select({
        "//build_settings:mock_runtime_false": glob(["real/*.h"]),
        "//conditions:default": glob(["mock/*.h"]),
    }),
    includes = ["."] + select({
        "//build_settings:mock_runtime_false": ["real"],
        "//conditions:default": ["mock"],
    }),
)

# Source files shared by both mock and real bitcode compilations.
_SHARED_SRCS = [
    "hipdnn_ep_runtime_state.cpp",
    "hipdnn_ep_runtime_tensor.cpp",
]

# Mock-only sources (5 files, no GPU SDK).
_MOCK_SRCS = [
    "mock/mock_gpu.cpp",
    "mock/memory.cpp",
    "mock/test_hip_from_dll.cpp",
]

# Real GPU sources (21 files, requires @therock).
_REAL_SRCS = [
    "real/activation.cpp",
    "real/cast.cpp",
    "real/causal_conv_with_state.cpp",
    "real/elementwise.cpp",
    "real/gather.cpp",
    "real/gemm.cpp",
    "real/gqa.cpp",
    "real/hip.cpp",
    "real/hipblas.cpp",
    "real/matmul.cpp",
    "real/matmul_nbits.cpp",
    "real/memory.cpp",
    "real/miopen.cpp",
    "real/power.cpp",
    "real/qmoe.cpp",
    "real/reduce_sum.cpp",
    "real/rotary_embedding.cpp",
    "real/simplified_layer_norm.cpp",
    "real/skip_simplified_layer_norm.cpp",
    "real/test_hip_from_dll.cpp",
]

# Compile all runtime sources to LLVM bitcode in one step.
# srcs and deps switch between mock and real via select().
compile_to_bc(
    name = "runtime_bc_objects",
    srcs = _SHARED_SRCS + select({
        "//build_settings:mock_runtime_false": _REAL_SRCS,
        "//conditions:default": _MOCK_SRCS,
    }),
    deps = [
        ":runtime_headers",
        "//schemas:HipSchemasLib",
        "//include:foundation_headers",
        "//include:hip_headers",
    ] + select({
        "//build_settings:mock_runtime_false": [
            "@therock//:therock",
            "//3rd-party/custom_kernels:custom_kernels_headers",
        ],
        "//conditions:default": [],
    }),
    copts = [
        "-D_CRT_SECURE_NO_WARNINGS",
        "-DNDEBUG",
        "-O2",
    ] + select({
        # compile_to_bc collects CcInfo includes but not defines; pass AMD
        # platform define explicitly so HIP headers select the right platform.
        "//build_settings:mock_runtime_false": ["-D__HIP_PLATFORM_AMD__"],
        "//conditions:default": [],
    }),
)

genrule(
    name = "runtime_bc",
    srcs = [":runtime_bc_objects"],
    outs = ["runtime.bc"],
    cmd = "$(location @bazel_cpp_toolchain//thirdparty/clang:llvm_link) $(locations :runtime_bc_objects) -o $@",
    tools = ["@bazel_cpp_toolchain//thirdparty/clang:llvm_link"],
)

genrule(
    name = "runtime_ir_data_cpp",
    srcs = [":runtime_bc"],
    outs = ["runtime_ir_data.cpp"],
    # Generates:
    #   extern "C" const unsigned char runtime_bc_data[] = {..., 0x00};
    #   extern "C" const size_t runtime_bc_data_size = <N>;
    # Matches the CMake two-step pipeline in lib/Target/LLVM/CMakeLists.txt.
    cmd = "$(location :make_runtime_ir_data) $(location :runtime_bc) $@",
    tools = [":make_runtime_ir_data"],
)

cc_library(
    name = "HipRuntimeBitcode",
    srcs = [":runtime_ir_data_cpp"],
    visibility = ["//visibility:public"],
)
