load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")
load(":compile_to_bc.bzl", "compile_to_bc")

# ============================================================================
# Runtime bitcode pipeline (mock runtime only)
# ============================================================================
# Mirrors CMakeLists.txt: compile .cpp → .bc via the CC toolchain (clang-cl
# on Windows, clang on Linux/macOS), llvm-link → runtime.bc,
# xxd.py → runtime_ir_data.cpp, wrap in cc_library.
# ============================================================================

py_binary(
    name = "xxd_py",
    srcs = ["//cmake:xxd.py"],
    main = "//cmake:xxd.py",
)

# Combined xxd + extern-C transform + size append in one Python script.
# Replaces the two-step CMake pipeline in lib/Target/LLVM/CMakeLists.txt.
py_binary(
    name = "make_runtime_ir_data",
    srcs = ["make_runtime_ir_data.py"],
    main = "make_runtime_ir_data.py",
)

# Header-only library exposing lib/Runtime and lib/Runtime/mock as include roots.
# cc_library.includes paths are relative to the package, prepended with the
# workspace root automatically — they flow into CcInfo.system_includes and
# are picked up by cc_common.compile() via compilation_contexts.
cc_library(
    name = "runtime_headers",
    hdrs = glob(["*.h"]) + glob(["mock/*.h"]),
    includes = [
        ".",      # → lib/Runtime (package dir)
        "mock",   # → lib/Runtime/mock
    ],
)

# Compile all mock runtime sources to LLVM bitcode in one step.
# cc_common.compile() handles include paths, system headers, and toolchain
# flags automatically. -emit-llvm is the only addition.
compile_to_bc(
    name = "runtime_bc_objects",
    srcs = [
        "hipdnn_ep_runtime_state.cpp",
        "hipdnn_ep_runtime_tensor.cpp",
        "mock/mock_gpu.cpp",
        "mock/memory.cpp",
        "mock/test_hip_from_dll.cpp",
    ],
    deps = [
        ":runtime_headers",
        "//schemas:HipSchemasLib",
        "//include:foundation_headers",
        "//include:hip_headers",
    ],
    copts = [
        "-D_CRT_SECURE_NO_WARNINGS",
        "-DNDEBUG",
        "-O2",
    ],
)

genrule(
    name = "runtime_bc",
    srcs = [":runtime_bc_objects"],
    outs = ["runtime.bc"],
    cmd = "$(location @bazel_cpp_toolchain//thirdparty/clang:llvm_link) $(locations :runtime_bc_objects) -o $@",
    tools = ["@bazel_cpp_toolchain//thirdparty/clang:llvm_link"],
)

genrule(
    name = "runtime_ir_data_cpp",
    srcs = [":runtime_bc"],
    outs = ["runtime_ir_data.cpp"],
    # Generates:
    #   extern "C" const unsigned char runtime_bc_data[] = {..., 0x00};
    #   extern "C" const size_t runtime_bc_data_size = <N>;
    # Matches the CMake two-step pipeline in lib/Target/LLVM/CMakeLists.txt.
    cmd = "$(location :make_runtime_ir_data) $(location :runtime_bc) $@",
    tools = [":make_runtime_ir_data"],
)

cc_library(
    name = "HipRuntimeBitcode",
    srcs = [":runtime_ir_data_cpp"],
    visibility = ["//visibility:public"],
)
