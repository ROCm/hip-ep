#include "rtc/hiprtc_module.h"

#include <hip/hiprtc.h>

#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <sstream>

// Generated by Kernels/CMakeLists.txt from the same _hip_get_build_flags() the
// AOT compile uses.
#include "rtc_compile_flags.h"

namespace hipdnn_ep {
namespace rtc {
namespace {

std::string getEnvVar(const char *key) {
#ifdef _WIN32
  char *v = nullptr;
  size_t len = 0;
  std::string out;
  if (_dupenv_s(&v, &len, key) == 0 && v != nullptr) {
    out = v;
    free(v);
  }
  return out;
#else
  const char *v = getenv(key);
  return v ? std::string(v) : std::string();
#endif
}

// Device 0, matching LlvmIrJit::detectCustomKernelArch, which picks the
// custom_kernels_<arch> DLL the AOT kernels come from. Probing the current
// device instead would let the two paths compile for different targets.
std::string archName() {
  hipDeviceProp_t prop;
  if (hipGetDeviceProperties(&prop, 0) != hipSuccess ||
      prop.gcnArchName[0] == '\0') {
    return std::string();
  }
  return std::string(prop.gcnArchName);
}

}  // namespace

bool enabled() {
  static const bool on = (getEnvVar("HIPDNN_EP_RTC") != "0");
  return on;
}

Module::Module(std::string name, const char *source, size_t source_size,
               std::vector<std::string> kernel_names)
    : name_(std::move(name)),
      source_(source),
      source_size_(source_size),
      kernel_names_(std::move(kernel_names)) {}

Module::~Module() {
  if (module_ != nullptr) {
    // Best effort: on process teardown the HIP runtime may already be gone.
    hipModuleUnload(module_);
  }
}

bool Module::compile(std::vector<char> &code) {
  const std::string arch = archName();
  if (arch.empty()) {
    fprintf(stderr, "[custom_kernels] rtc(%s): no device architecture\n",
            name_.c_str());
    return false;
  }

  hiprtcProgram prog = nullptr;
  const std::string src(source_, source_size_);
  hiprtcResult rc = hiprtcCreateProgram(&prog, src.c_str(),
                                        (name_ + ".hip").c_str(), 0, nullptr,
                                        nullptr);
  if (rc != HIPRTC_SUCCESS) {
    fprintf(stderr, "[custom_kernels] rtc(%s): createProgram: %s\n",
            name_.c_str(), hiprtcGetErrorString(rc));
    return false;
  }

  // Must precede compilation; hipRTC resolves these while parsing.
  for (const std::string &k : kernel_names_) {
    hiprtcAddNameExpression(prog, k.c_str());
  }

  // hipRTC defaults to -O3 while the kernels are built at -O2; the flags have to
  // match or this is not the same code the AOT path produces.
  std::vector<std::string> opt_storage{"--gpu-architecture=" + arch};
  {
    std::istringstream flags{HIPDNN_EP_RTC_AOT_COMPILE_FLAGS};
    std::string flag;
    while (flags >> flag) {
      opt_storage.push_back(flag);
    }
  }
  std::vector<const char *> opts;
  opts.reserve(opt_storage.size());
  for (const std::string &o : opt_storage) {
    opts.push_back(o.c_str());
  }
  rc = hiprtcCompileProgram(prog, static_cast<int>(opts.size()), opts.data());
  if (rc != HIPRTC_SUCCESS) {
    size_t log_size = 0;
    hiprtcGetProgramLogSize(prog, &log_size);
    std::string log(log_size ? log_size : 1, '\0');
    if (log_size) hiprtcGetProgramLog(prog, &log[0]);
    fprintf(stderr, "[custom_kernels] rtc(%s): compile failed: %s\n%s\n",
            name_.c_str(), hiprtcGetErrorString(rc), log.c_str());
    hiprtcDestroyProgram(&prog);
    return false;
  }

  for (const std::string &k : kernel_names_) {
    const char *lowered = nullptr;
    if (hiprtcGetLoweredName(prog, k.c_str(), &lowered) == HIPRTC_SUCCESS &&
        lowered != nullptr) {
      lowered_names_[k] = lowered;
    } else {
      fprintf(stderr, "[custom_kernels] rtc(%s): no lowered name for %s\n",
              name_.c_str(), k.c_str());
      hiprtcDestroyProgram(&prog);
      return false;
    }
  }

  size_t code_size = 0;
  hiprtcGetCodeSize(prog, &code_size);
  code.resize(code_size);
  const bool got_code =
      (hiprtcGetCode(prog, code.data()) == HIPRTC_SUCCESS) && code_size > 0;
  hiprtcDestroyProgram(&prog);
  if (!got_code) {
    fprintf(stderr, "[custom_kernels] rtc(%s): getCode failed\n",
            name_.c_str());
    return false;
  }
  return true;
}

void Module::ensureLoaded() {
  std::call_once(load_once_, [this]() {
    const auto started = std::chrono::steady_clock::now();

    std::vector<char> code;
    if (!compile(code)) {
      return;
    }

    hipError_t err = hipModuleLoadData(&module_, code.data());
    if (err != hipSuccess) {
      fprintf(stderr, "[custom_kernels] rtc(%s): hipModuleLoadData: %s\n",
              name_.c_str(), hipGetErrorString(err));
      return;
    }

    for (const std::string &k : kernel_names_) {
      hipFunction_t f = nullptr;
      err = hipModuleGetFunction(&f, module_, lowered_names_[k].c_str());
      if (err != hipSuccess) {
        fprintf(stderr, "[custom_kernels] rtc(%s): getFunction(%s): %s\n",
                name_.c_str(), k.c_str(), hipGetErrorString(err));
        return;
      }
      functions_[k] = f;
    }
    load_ok_ = true;

    const double ms = std::chrono::duration<double, std::milli>(
                          std::chrono::steady_clock::now() - started)
                          .count();
    fprintf(stderr,
            "[custom_kernels] rtc(%s): %zu kernels, %zu bytes, compiled in "
            "%.1f ms\n",
            name_.c_str(), kernel_names_.size(), code.size(), ms);
  });
}

hipFunction_t Module::getFunction(const std::string &kernel_name) {
  ensureLoaded();
  if (!load_ok_) return nullptr;
  auto it = functions_.find(kernel_name);
  return it == functions_.end() ? nullptr : it->second;
}

}  // namespace rtc
}  // namespace hipdnn_ep
