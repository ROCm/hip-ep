{
  "schema": "hipdnn-kernel-ut-interface/v1",
  "description": "Inputs an external caller passes to run the kernel unit tests: the packaged controller, the options every leaf shares, and each leaf's custom-case parameters. unit_test/README.md \"External invocation\" explains the fields; common/test_ut_interface.py checks this file against kernel_ut_main.cpp, the leaf Makefiles and the leaf sources.",
  "controller": {
    "executable": "bin/hipdnn-kernel-ut.exe",
    "args": [
      {"flag": "--arch", "type": "string", "default": "detected from GPU 0", "description": "Selects bin/kernel-tests/<arch>/ with the EP's DLL rule: the ISA's own directory first, then its generic target's (gfx115x -> gfx11-generic)."},
      {"flag": "--mode", "type": "enum", "choices": ["lookup", "autotune"], "default": "lookup", "description": "lookup resolves configs from the tables embedded in custom_kernels_<arch>.dll and falls through to autotune on a miss; autotune bypasses the tables."},
      {"flag": "--coverage", "type": "enum", "choices": [1, 2, 3], "default": 3, "description": "Shape-coverage tier passed to every leaf as --coverage <N>."},
      {"flag": "--timing", "type": "enum", "choices": ["screen", "standard", "confirm"], "default": "standard", "env": "HIPDNN_UT_TIMING", "description": "Timing preset passed to every leaf through HIPDNN_UT_TIMING. confirm is the formal measurement."}
    ],
    "leaf_command": "<bin>/kernel-tests/<arch>/<package_executable> --coverage <N>",
    "leaf_environment": ["HIPDNN_UT_TIMING", "HIPDNN_RESULTS_CSV", "HIPDNN_RESULTS_ARCH", "HIPDNN_RESULTS_OP", "HIPDNN_RESULTS_LEAF", "HIPDNN_RESULTS_MODE", "HIPDNN_KERNEL_UT_MODE", "HIPDNN_MATMUL_AUTOTUNE_MODE", "HIPDNN_GQA_AUTOTUNE_MODE", "HIPDNN_KERNEL_UT_STDERR"],
    "exit_codes": {"0": "Every leaf passed.", "1": "At least one leaf failed or could not be launched.", "2": "Bad argument, no GPU detected, or no packaged tests for that arch."},
    "outputs": ["bin/out/results.csv (one row per case and one shape=suite row per leaf)", "bin/out/<executable stem>.stderr.log for a failed leaf"]
  },
  "common": {
    "make": [
      {"var": "HIP_SDK", "required": true, "default": "$(HIP_PATH)", "description": "HIP SDK root containing bin/hipcc.exe."},
      {"var": "OFFLOAD", "default": "--offload-arch=gfx11-generic", "description": "Build target. gfx11-generic covers gfx115x; pass --offload-arch=gfx1170 or --offload-arch=gfx1171 for those chips. gfx1151 is the default validation chip."},
      {"var": "LUT_ARCH", "default": "GPU of the build machine (amdgpu-arch) for a generic target", "description": "Chip whose table a MODE=lookup build embeds."},
      {"var": "MODE", "default": "lookup", "choices": ["lookup", "autotune"], "description": "lookup links the real resolver and table and sets the kernel's own HIPDNN_<OP>_AUTOTUNE_MODE=lookup; autotune never reads a table. Ops without a table only label results.csv."},
      {"var": "COVERAGE", "default": 3, "choices": [1, 2, 3], "description": "Shape-coverage tier for make test."},
      {"var": "TIMING", "default": "standard", "choices": ["screen", "standard", "confirm"], "description": "Timing preset, exported as HIPDNN_UT_TIMING."},
      {"var": "RANK", "default": 0, "choices": [0, 1], "description": "RANK=1 builds the UT ranking variant (ops with an offline LUT); it forces MODE=autotune."},
      {"var": "BUILD_DIR", "default": "out", "description": "Build and results directory."},
      {"var": "FLATC", "default": "flatc", "description": "flatc used by a MODE=lookup build."},
      {"var": "FLATBUFFERS_INC", "default": "", "description": "flatbuffers include directory for a MODE=lookup build."},
      {"var": "ADLX_INCLUDE", "default": "", "description": "Optional ADLX SDK include directory; enables GPU-clock telemetry in UT_TIMING."},
      {"var": "CSV_FRESH", "default": 1, "description": "1 truncates <BUILD_DIR>/results.csv before test / test_custom."}
    ],
    "env": [
      {"name": "HIPDNN_UT_TIMING", "values": ["screen", "standard", "confirm"], "default": "standard", "description": "Timing preset of the shared timer."},
      {"name": "HIPDNN_UT_COVERAGE", "values": [1, 2, 3], "description": "Coverage tier when --coverage is absent."},
      {"name": "HIPDNN_RESULTS_CSV", "description": "Append one row per case to this CSV; HIPDNN_RESULTS_OP / _LEAF / _ARCH / _MODE label the rows."},
      {"name": "HIPDNN_MATMUL_AUTOTUNE_MODE", "values": ["lookup", "online"], "description": "The MatMulNBits kernel's own config source. A standalone run must set it together with HIPDNN_KERNEL_UT_MODE."},
      {"name": "HIPDNN_GQA_AUTOTUNE_MODE", "values": ["lookup", "online"], "description": "The GQA kernel's own config source."},
      {"name": "HIPDNN_KERNEL_UT_MODE", "values": ["lookup", "autotune"], "description": "Mode label read by the leaf."},
      {"name": "HIPDNN_KERNEL_UT_WARM", "values": [1], "description": "Time one operand copy on warm caches instead of the cold operand rotation."},
      {"name": "HIPDNN_KERNEL_UT_STDERR", "description": "Set by the controller: the leaf's stderr log, read back for config diagnostics."},
      {"name": "HIPDNN_UT_EVIDENCE_BINDING", "description": "Opaque caller string copied into UT_TIMING records."},
      {"name": "HIPDNN_UT_RANK", "description": "RANK=1 builds: candidate CSV (leaf,shape,priority,config) to rank."},
      {"name": "HIPDNN_UT_RANK_CATALOG", "values": [1], "description": "RANK=1 builds: print the config catalog for the requested shapes."},
      {"name": "HIPDNN_UT_RANK_REFERENCE", "values": [1], "description": "RANK=1 builds: sequential confirm reference of the supplied candidates."},
      {"name": "HIPDNN_UT_GPU_ADMISSION", "description": "Optional per-case launcher handshake prefix (FP16 W4 MatMulNBits and FP16 KV GQA decode/prefill); see common/README.md."}
    ],
    "leaf_outputs": ["stdout UT_TIMING / UT_TIMING_BINDING JSON records", "stderr UT_TIMING_INVALID diagnostics", "exit code 0 only when every case passed"]
  },
