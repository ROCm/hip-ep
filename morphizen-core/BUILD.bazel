# Generate config JSON binary (Python script equivalent)
# Note: This would normally run src/binary/config_json_binary.hpp.py with various parameters
py_binary(
    name = "config_json_binary_py",
    srcs = [
        "src/binary/config_json_binary.hpp.bazel.py",
    ],
    main = "src/binary/config_json_binary.hpp.bazel.py",
    deps = [
        "//tools:xxd",
    ],
)

label_flag(
    name = "label_morphizen_config.json",
    build_setting_default = "//morphizen-core:etc/morphizen_config.json",
)

genrule(
    name = "generate_morphizen_config_json",
    outs = [
        "config_json_binary.hpp",
        "morphizen_config.json",
    ],
    cmd = """
    $(location :config_json_binary_py) --in_morphizen_config_json $(location :label_morphizen_config.json) --out_morphizen_config_json $(location :morphizen_config.json) --morphizen_config_binary_hpp $(location :config_json_binary.hpp) --is_trim_config OFF --enable_default_config ON
    """,
    tools = [
        ":config_json_binary_py",
        ":label_morphizen_config.json",
    ],
)


# Main morphizen-core library (static)
# using glob is generally not considered a good practice in Bazel for several reasons:
#
# Build hermeticity: glob can pick up files that weren't intended to be part of the build, making builds non-deterministic
# Explicit dependencies: Bazel philosophy emphasizes explicit, declarative dependencies
# Build performance: glob requires filesystem scanning which can slow down builds
# Maintenance issues: When files are added/removed, the build behavior changes implicitly
cc_library(
    name = "morphizen-core-static",
    srcs = glob(
        [
            "src/*.cpp",
            "src/*.hpp",
            "src/binary/*.cpp",
        ],
        exclude = [
            # Platform-specific files handled by select() below
            "src/util_mswin.cpp",
            "src/util_linux.cpp",
            "src/util_unknown.cpp",
            "src/mmap_file_win.cpp",
            "src/mmap_file_win.hpp",
            "src/mmap_file_tmphandle_win.cpp",
            "src/mmap_file_tmphandle_win.hpp",
            # Entry point, not part of the library
            "src/main.cpp",
        ],
    ) + select({
        "@bazel_tools//src/conditions:windows": [
            "src/mmap_file_win.cpp",
            "src/mmap_file_win.hpp",
            "src/mmap_file_tmphandle_win.cpp",
            "src/mmap_file_tmphandle_win.hpp",
            "src/util_mswin.cpp",
        ],
        "@bazel_tools//src/conditions:linux_x86_64": [
            "src/util_linux.cpp",
        ],
        "//conditions:default": [
            "src/util_unknown.cpp",
        ],
    }),
    hdrs = [
        ":config_json_binary.hpp",
        ":mem_binary_file.hpp.inc",
        "include/morphizen/tar.h",
        ":morphizen_version_info.hpp.inc",
        ":xclbin.h",
    ],
    copts = select({
        "@bazel_tools//src/conditions:windows": [
            "/W0",  # Suppress all warnings
            "/DONNX_NAMESPACE=onnx",
            "/DMORPHIZEN_EXPORT_DLL=1",  # Allow internal headers (satisfies _sanity_check.hpp)
            "/UUNICODE",  # Undefine UNICODE (toolchain sets it; util_mswin.cpp uses LPCSTR)
            "/U_UNICODE",
            "/Zc:__cplusplus",
        ],
        "//conditions:default": [
            "-w",  # Suppress all warnings
            "-DONNX_NAMESPACE=onnx",
            "-DMORPHIZEN_EXPORT_DLL=1",
            "-fPIC",
        ],
    }),
    includes = [
        ".",  # For generated files in current directory
        "include",  # Public headers
        "src",  # Private implementation headers
        # Note: ONNXRuntime includes would be added by @onnxruntime//:onnxruntime_headers dependency
        # Note: ../3rd-party would be handled by external dependencies
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":morphizen-core-headers",
        ":morphizen-core-proto-headers",
        ":morphizen_proto_lib",
        "//morphizen-foundation",
        "//morphizen-graph:morphizen-graph",
        "//morphizen-pattern:morphizen-pattern",
        "//morphizen-utils:morphizen_utils",
        "//morphizen-ort-api-ext",
        "@hash-library//:hash-library",
        "@glog",
        "@gsl",
        "@onnx//:onnx",
        "@onnxruntime//:onnxruntime_headers",
        "@protobuf",
        "@zlib",
    ],
)

# Alias for backward compatibility
cc_library(
    name = "morphizen-core-headers",
    hdrs = glob(["include/morphizen/*.hpp", "include/morphizen/*.h"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
cc_library(
    name = "morphizen-core-proto-headers",
    hdrs = [":morphizen_proto_pb_h"],
    visibility = ["//visibility:public"],
)
