        "src/ep_shared_context_workspace.hpp",
        # Generated files (from genrules)
    ] + select({
        "@bazel_tools//src/conditions:windows": [
            "src/mmap_file_win.cpp",
            "src/mmap_file_win.hpp",
            "src/util_mswin.cpp",
        ],
