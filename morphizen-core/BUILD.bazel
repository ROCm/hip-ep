# # Proto libraries for morphizen-core
# No, it's **not a good practice** to combine all proto files into a single `proto_library` rule. Here's why:

# ## **Best Practices for Proto Libraries:**

# 1. **Separate concerns**: Each proto file should have its own `proto_library` rule
# 2. **Granular dependencies**: Allows targets to depend only on what they need
# 3. **Parallel compilation**: Bazel can compile different proto files in parallel
# 4. **Better caching**: Changes to one proto don't invalidate others
# 5. **Clearer dependency graph**: Makes it obvious which parts of the code depend on which protos
# ## **Summary of Best Practices:**

# ✅ **Keep separate proto_library rules** (what we have)
# ✅ **Create convenience targets** for grouping (what we just added)
# ✅ **Use granular dependencies** where possible
# ❌ **Don't combine unrelated proto files** into one rule

# This gives us:
# - **Modularity**: Each proto can be built independently
# - **Convenience**: Proto targets available when you need them
# - **Performance**: Better parallelization and caching
# - **Maintainability**: Clear separation of concerns

# Now let's test if the morphizen-core package builds correctly:

proto_library(
    name = "anchor_point_proto",
    srcs = ["src/anchor_point.proto"],
    strip_import_prefix = "src",
    visibility = ["//visibility:public"],
)

proto_library(
    name = "capability_proto",
    srcs = ["src/capability.proto"],
    strip_import_prefix = "src",
    visibility = ["//visibility:public"],
    deps = ["@protobuf//:struct_proto"],
)

proto_library(
    name = "config_proto",
    srcs = ["src/config.proto"],
    deps = [ ":version_proto"] ,
    strip_import_prefix = "src",
    visibility = ["//visibility:public"],
)
proto_library(
    name = "pass_context_proto",
    strip_import_prefix = "src",
    srcs = [":src/pass_context.proto"],
    deps = [":capability_proto", ":config_proto", ":anchor_point_proto"],
    visibility = ["//visibility:public"],
)


proto_library(
    name = "version_proto",
    srcs = [":src/version.proto"],
    strip_import_prefix = "src",
    visibility = ["//visibility:public"],
)

# C++ proto libraries
cc_proto_library(
    name = "anchor_point_cc_proto",
    deps = [":anchor_point_proto"],
)

cc_proto_library(
    name = "capability_cc_proto",
    deps = [":capability_proto"],
)

cc_proto_library(
    name = "config_cc_proto",
    deps = [":config_proto"],
)

cc_proto_library(
