)


# Convenience target to group all proto dependencies
collect_pb(
    name = "morphizen_proto_pb_h",
    visibility = ["//visibility:public"],
    srcs = [
        ":anchor_point_cc_proto",
        ":capability_cc_proto",
        ":config_cc_proto",
        ":pass_context_cc_proto",
        ":pattern_cc_proto",
        ":version_cc_proto",
    ],
    output_dir = "morphizen",
    extensions = ".pb.h",
)

collect_pb(
    name = "morphizen_proto_pb_cc",
    visibility = ["//visibility:public"],
    srcs = [
        ":anchor_point_cc_proto",
        ":capability_cc_proto",
        ":config_cc_proto",
        ":pass_context_cc_proto",
        ":pattern_cc_proto",
        ":version_cc_proto",
    ],
    output_dir = "morphizen",
    extensions = ".pb.cc",
)
cc_library(
    name = "morphizen_proto_lib",
    visibility = ["//visibility:public"],
    deps = [":anchor_point_cc_proto",
        ":capability_cc_proto",
        ":config_cc_proto",
        ":pass_context_cc_proto",
        ":pattern_cc_proto",
        ":version_cc_proto",],
)
# Generated files that would normally be created by CMake custom commands
# Based on morphizen-core-static.cmake configuration

# Generate morphizen_version_info.hpp.inc (referenced in CMake)
genrule(
    name = "generate_version_info_hpp_inc",
    outs = ["morphizen_version_info.hpp.inc"],
    cmd = """
    echo '{"morphizen", "N/A", "N/A"},' > $@
    """,
)


## xclbin.h (vendored)
genrule(
    name = "test_xclbin.h",
    srcs = [
        "//3rd-party/xclbin:xclbin.h",
    ],
    outs = ["xclbin.h"],
    cmd = "cp $(SRCS)  $@",
    visibility = ["//visibility:public"],
)

# Generate config JSON binary (Python script equivalent)
# Note: This would normally run src/binary/config_json_binary.hpp.py with various parameters
py_binary(
    name = "config_json_binary_py",
    srcs = [
        "src/binary/config_json_binary.hpp.bazel.py",
    ],
    main = "src/binary/config_json_binary.hpp.bazel.py",
    deps = [
        "//scripts/bazel:xxd",
    ],
)

label_flag(
    name = "label_morphizen_config.json",
    build_setting_default = "//morphizen-core:etc/morphizen_config.json",
)

genrule(
    name = "generate_morphizen_config_json",
    outs = [
        "config_json_binary.hpp",
        "morphizen_config.json",
    ],
    cmd = """
    $(location :config_json_binary_py) --in_morphizen_config_json $(location :label_morphizen_config.json) --out_morphizen_config_json $(location :morphizen_config.json) --morphizen_config_binary_hpp $(location :config_json_binary.hpp) --is_trim_config OFF --xclbin_path "" --enable_default_config ON
    """,
    tools = [
        ":config_json_binary_py",
        ":label_morphizen_config.json",
    ],
)


# Main morphizen-core library (static)
# using glob is generally not considered a good practice in Bazel for several reasons:
#
# Build hermeticity: glob can pick up files that weren't intended to be part of the build, making builds non-deterministic
# Explicit dependencies: Bazel philosophy emphasizes explicit, declarative dependencies
# Build performance: glob requires filesystem scanning which can slow down builds
# Maintenance issues: When files are added/removed, the build behavior changes implicitly
cc_library(
    name = "morphizen-core-static",
    srcs = [
        # Generated version files (from CMake custom commands)
        "src/version_info.cpp",
        "src/version_info.hpp",
        # Core implementation files
        "src/pass_context_imp.hpp",
        "src/pass_context_imp.cpp",
        "src/anchor_point.cpp",
        "src/anchor_point_imp.cpp",
        "src/anchor_point_imp.hpp",
        "src/pass_imp.hpp",
        "src/pass_imp.cpp",
        "src/tar_ball.cpp",
        "src/tar_ball.hpp",
        "src/tar_file.cpp",
        "src/tar_file.hpp",
        "src/tar_header.hpp",
        "src/tar_header.cpp",
        "src/tar_entry.cpp",
        "src/tar_entry.hpp",
        "src/mmap_file.hpp",
        "src/mmap_file.cpp",
        "src/mem_stream_buffer.hpp",
        "src/pass.cpp",
        "src/model.cpp",
        "src/graph.cpp",
        "src/node_attr.cpp",
        "src/node_arg.cpp",
        "src/tensor_proto.cpp",
        "src/node_input.cpp",
        "src/node.cpp",
        "src/profile_utils.hpp",
        "src/profile_utils.cpp",
