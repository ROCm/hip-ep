; Export definitions for morphizen-mlir-compiler.dll
; This file specifies the C API functions exported from the DLL

LIBRARY morphizen-mlir-compiler

EXPORTS
    ; Main compilation entry point (now binary-safe, handles both text and bytecode)
    morphizen_mlir_compile

    ; Version information
    morphizen_mlir_get_version
