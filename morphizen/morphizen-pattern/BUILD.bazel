load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_proto//proto:defs.bzl", "proto_library")
load("//scripts/bazel:collect_pb.bzl", "collect_pb")

proto_library(
    name = "pattern_proto",
    srcs = ["proto/pattern.proto"],
    strip_import_prefix = "proto",
    visibility = ["//visibility:public"],
)

cc_proto_library(
    name = "pattern_cc_proto",
    deps = [":pattern_proto"],
    visibility = ["//visibility:public"],
)

collect_pb(
    name = "pattern_proto_pb_h",
    srcs = [":pattern_cc_proto"],
    output_dir = "morphizen",
    extensions = ".pb.h",
    visibility = ["//visibility:public"],
)

# Exposes morphizen/pattern.pb.h via includes = ["."] (output dir root)
cc_library(
    name = "pattern_proto_headers",
    hdrs = [":pattern_proto_pb_h"],
    includes = ["."],
    deps = [":pattern_cc_proto"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "morphizen-pattern",
    srcs = glob(["src/*.cpp", "src/*.hpp"]),
    hdrs = glob(["include/morphizen/*.hpp"]),
    strip_include_prefix = "include",
    copts = select({
        "@bazel_tools//src/conditions:windows": [
            "/W0",
            "/DONNX_NAMESPACE=onnx",
            "/DMORPHIZEN_EXPORT_DLL=1",
            "/Zc:__cplusplus",
        ],
        "//conditions:default": [
            "-w",
            "-DONNX_NAMESPACE=onnx",
            "-DMORPHIZEN_EXPORT_DLL=1",
            "-fPIC",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":pattern_proto_headers",
        "//morphizen-graph:morphizen-graph",
        "@glog",
        "@gsl",
        "@protobuf",
    ],
)
