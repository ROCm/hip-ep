load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "morphizen-pattern",
    srcs = glob(["src/*.cpp", "src/*.hpp"]),
    hdrs = glob(["include/morphizen/*.hpp"]),
    strip_include_prefix = "include",
    includes = ["src"],
    copts = select({
        "@bazel_tools//src/conditions:windows": [
            "/W0",
            "/DONNX_NAMESPACE=onnx",
            "/DMORPHIZEN_EXPORT_DLL=1",
            "/Zc:__cplusplus",
        ],
        "//conditions:default": [
            "-w",
            "-DONNX_NAMESPACE=onnx",
            "-DMORPHIZEN_EXPORT_DLL=1",
            "-fPIC",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//morphizen-graph:morphizen-graph",
        "//morphizen-utils:morphizen_utils",
        "@glog",
        "@gsl",
    ],
)
