From dd7a077d144807d4d27e74ed32b0b6618deb0a5e Mon Sep 17 00:00:00 2001
From: zhenzew <zhenzew@amd.com>
Date: Thu, 21 May 2026 02:15:17 -0500
Subject: [PATCH] fix(partitioning_utils): include Loop/If/Scan implicit inputs
 in MetaDef

`utils::MakeComputeCapability` walks each supported node's `InputDefs()`
to populate `IndexedSubGraph::MetaDef::inputs` but skips
`ImplicitInputDefs()`. For region-bearing ops (Loop / If / Scan), the
outer-scope captures (used by body subgraphs) live in
`ImplicitInputDefs()`, not `InputDefs()`. When an EP claims a Loop / If /
Scan node as part of a fused partition, those captures are silently
dropped from the MetaDef.

`Graph::FinalizeFuseSubGraph` consumes only `meta_def->inputs` to
populate the fused node's `InputDefs()` and rewire outer-scope edges, so
the captures never reach the fused-node boundary. The EP that owns the
fused subgraph has no boundary value-info for the captured tensors and
cannot bind them at Compute time.

Scope of impact: only EPs that use `utils::CreateSupportedPartitions` /
`utils::MakeComputeCapability`. In-tree this is the plugin EP path
(`PluginExecutionProvider::GetCapability` via
`EpGraphSupportInfo_AddNodesToFuse`) and the `internal_testing_ep`.
TRT / MIGraphX / NV-TRT-RTX / VitisAI roll their own MetaDef and already
walk `ImplicitInputDefs()` themselves; they are not affected.

Fix: mirror the existing `InputDefs()` loop with an `ImplicitInputDefs()`
loop using the same "produced inside the partition -> skip, otherwise
add to subgraph inputs" semantics. The implicit loop runs after the
explicit loop so explicit-operand index ordering in `meta_def->inputs`
is preserved.
---
 .../core/providers/partitioning_utils.cc      | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/onnxruntime/core/providers/partitioning_utils.cc b/onnxruntime/core/providers/partitioning_utils.cc
index f368537d65..f1e2f11504 100644
--- a/onnxruntime/core/providers/partitioning_utils.cc
+++ b/onnxruntime/core/providers/partitioning_utils.cc
@@ -321,6 +321,25 @@ std::unique_ptr<ComputeCapability> MakeComputeCapability(const GraphViewer& grap
       }
     }
 
+    // Region-bearing ops (Loop/If/Scan) reference outer-scope SSA values via
+    // ImplicitInputDefs rather than InputDefs. When an EP claims the whole
+    // control-flow op, those implicit captures must also be in MetaDef::inputs
+    // so FinalizeFuseSubGraph can rewire the outer-scope edges onto the fused
+    // node's InputDefs. Without this, plugin EPs that fuse Loop/If/Scan lose
+    // the captures at the fused-node boundary and cannot resolve them at
+    // Compute time.
+    for (const auto* input : node->ImplicitInputDefs()) {
+      if (!input->Exists()) {
+        continue;
+      }
+      if (!Contains(node_outputs, input)) {
+        if (!Contains(subgraph_inputs, input)) {
+          subgraph_inputs.insert(input);
+          ordered_subgraph_inputs.push_back(input);
+        }
+      }
+    }
+
     const auto& output_defs = node->OutputDefs();
     for (const auto* output_def : output_defs) {
       node_outputs.insert(output_def);
-- 
