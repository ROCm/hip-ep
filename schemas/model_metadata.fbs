namespace mlir.hip;

table TensorInfo {
  shape: [int64];
  element_size: int64;
}

table ConstantInfo {
  size:   int64;
  offset: int64;
}

table HipModelMetaInfo {
  version: int32 = 1;
  constants_filename: string;
  constants: [ConstantInfo];
  input_count: int64;
  output_count: int64;
  inputs: [TensorInfo];
  outputs: [TensorInfo];
}

root_type HipModelMetaInfo;
