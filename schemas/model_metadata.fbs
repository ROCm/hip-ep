namespace mlir.hip;

table TensorInfo {
  shape: [int64];
  element_size: int64;
}

// Per-constant source descriptor baked into __metadata_blob. When a
// ConstantInfo.source is NONE, the runtime falls back to the bulk
// constants-file read (constants_filename). Otherwise it uploads this
// constant tensor-by-tensor using the source-specific payload.
table SplatSource {
  // Element bytes (1 / 2 / 4 / 8), tile-expanded to ConstantInfo.size
  // at runtime.
  elem_bytes: [ubyte];
}
table FileRefSource {
  path:        string;  // absolute OS path to external data file
  file_offset: int64;   // byte offset within that file
}
// Hybrid path: a constant whose source could not be re-read on demand
// (mem-addr alias of DenseAttr / OrtValue) was packed into the small
// per-session partial constants file. The runtime fetches `size` bytes at
// `mem_offset` from HipModelMetaInfo.constants_filename through
// the EP's FileSystem and uploads via the per-entry staging buffer.
table MemSource {
  mem_offset: int64; // byte offset within HipModelMetaInfo.constants_filename
}
union ConstantSource { SplatSource, FileRefSource, MemSource }

table ConstantInfo {
  size:   int64;
  offset: int64;
  source: ConstantSource;
  // Row-padded constant: the source holds size / row_pitch dense rows of
  // row_bytes bytes, which the per-entry upload places row_pitch bytes apart
  // (size is the padded footprint in the blob). 0 = dense, copied as-is.
  row_bytes: int64 = 0;
  row_pitch: int64 = 0;
}

// HipModelMetaInfo.version. RowPadded adds row-padded constants, whose
// ConstantInfo.size is the padded footprint rather than the source byte count;
// the writer uses it only when some constant is row-padded, and a runtime
// rejects a version above the MAX it was built with.
enum ModelMetaVersion : int32 {
  Dense = 1,
  RowPadded = 2,
}

table HipModelMetaInfo {
  version: int32 = 1;  // a ModelMetaVersion
  constants_filename: string;
  constants: [ConstantInfo];
  input_count: int64;
  output_count: int64;
  inputs: [TensorInfo];
  outputs: [TensorInfo];
}

root_type HipModelMetaInfo;
