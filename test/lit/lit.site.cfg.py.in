#
# WHY this file exists: lit.cfg.py is static source and cannot embed CMake
# variables (build dir, tool paths). CMake generates this file to bridge the
# gap, injecting paths known only at configure time. LIT auto-discovers
# lit.site.cfg.py in the build directory and loads it BEFORE lit.cfg.py, so
# config.llvm_tools_dir is guaranteed to be set when lit.cfg.py runs.
# (LLVMConfig and add_tool_substitutions both require it to exist up front.)

@LIT_SITE_CFG_IN_HEADER@

import lit.llvm

# llvm_tools_dir must be set before lit.llvm.initialize() because LLVMConfig()
# reads it immediately when constructed in lit.cfg.py.
config.llvm_tools_dir = r"@LLVM_TOOLS_BINARY_DIR@"
config.python_executable = r"@Python3_EXECUTABLE@"

# hip_build_dir: base build directory; lit.cfg.py appends per-tool subdirs.
config.hip_build_dir = r"@CMAKE_BINARY_DIR@"

# hip_build_mode: config name injected by configure_lit_site_cfg().
# For VS multi-config generators it is set to %(build_mode)s (a Python format
# string) so that lit substitutes the actual config (Debug/Release) at runtime.
config.hip_build_mode = "@LLVM_BUILD_MODE@"

# Whether the sample plugin was statically linked into the host (i.e. `sample`
# is in HIPDNN_EP_COMPILER_PLUGINS). lit.cfg.py turns this into the
# `hip_static_plugins` feature that gates the Plugin/ pass tests. Works on every
# platform (static linking needs no symbol export).
config.hip_static_plugins = @HIPDNN_STATIC_PLUGINS_LIT_FEATURE@

lit.llvm.initialize(lit_config, config)

# Resolve %(build_mode)s for VS multi-config generators. No-op for single-config.
# If --param build_mode=<config> was not passed, default to Debug so tool paths
# like tools/hip-mlir-opt/Debug/ resolve correctly without extra lit arguments.
try:
    config.hip_build_mode = config.hip_build_mode % lit_config.params
except KeyError:
    config.hip_build_mode = "Debug"

# Hand off to the static main config.
lit_config.load_config(config, r"@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py")
