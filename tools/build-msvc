# Build wrapper with automatic MSVC environment setup
# This wrapper automatically sources the MSVC environment if not already set,
# then executes cmake --build with all provided arguments.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Check if MSVC environment is already set
if [[ -z "${VCINSTALLDIR:-}" ]]; then
    # MSVC environment not set, source it now
    if [[ -f "$SCRIPT_DIR/setup_msvc_env_bash.sh" ]]; then
        source "$SCRIPT_DIR/setup_msvc_env_bash.sh" || exit 1
    else
        echo "ERROR: setup_msvc_env_bash.sh not found at: $SCRIPT_DIR/setup_msvc_env_bash.sh" >&2
        exit 1
    fi
fi

# Execute cmake --build with all arguments
exec cmake --build "$@"
