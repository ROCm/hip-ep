+        std::fprintf(stderr, "[AMDGPU] HIP EP state-slot API unresolved\n");
+      return false;
+    }
+    const int status = copy(
+        static_cast<const HipEpStateSlotDesc*>(descs_device),
+        static_cast<const HipEpStateSlotDesc*>(descs_host), count, src_slot, dst_slot);
+    if (status == kHipEpDeviceApiSuccess) {
+      static std::atomic<bool> traced{};
+      if (std::getenv("ORTGENAI_AMDGPU_TRACE_STATE_SLOT_COPY") &&
+          !traced.exchange(true))
+        std::fprintf(stderr,
+                     "[AMDGPU] HIP EP batched state-slot copy active (%d tensors)\n",
+                     count);
+      return true;
+    }
+    if (status == kHipEpDeviceApiUnavailable) {
+      if (std::getenv("ORTGENAI_AMDGPU_TRACE_STATE_SLOT_COPY"))
+        std::fprintf(stderr, "[AMDGPU] HIP EP state-slot API unavailable\n");
+      return false;
+    }
+    throw std::runtime_error("HIP EP batched state-slot copy failed with status " +
+                             std::to_string(status));
+  }
