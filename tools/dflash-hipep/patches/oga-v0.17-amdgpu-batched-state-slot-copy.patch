+constexpr uint32_t kHipEpDeviceApiVersion = 1;
+constexpr int kHipEpDeviceApiSuccess = 0;
+constexpr int kHipEpDeviceApiUnavailable = 2;
+
+struct HipEpStateSlotDesc {
+  void* base;
+  uint64_t slot_bytes;
+};
+
+static_assert(sizeof(HipEpStateSlotDesc) == sizeof(StateSlotDesc));
+static_assert(alignof(HipEpStateSlotDesc) == alignof(StateSlotDesc));
+static_assert(offsetof(HipEpStateSlotDesc, base) == offsetof(StateSlotDesc, base));
+static_assert(offsetof(HipEpStateSlotDesc, slot_bytes) == offsetof(StateSlotDesc, slot_bytes));
+
+using HipEpDeviceApiVersionFn = uint32_t (*)();
+using HipEpCopyStateSlotsFn = int (*)(const HipEpStateSlotDesc*, const HipEpStateSlotDesc*,
+                                      int32_t, int32_t, int32_t);
+
+struct HipEpDeviceApi {
+  HipEpCopyStateSlotsFn copy_state_slots{};
+};
+
+HipEpDeviceApi ResolveHipEpDeviceApi() {
+#if defined(_WIN32)
+  HMODULE provider = GetModuleHandleA("hipgpu.dll");
+  if (!provider)
+    return {};
+  auto get_symbol = [&](const char* name) {
+    return reinterpret_cast<void*>(GetProcAddress(provider, name));
+  };
+#elif defined(__linux__) && !defined(__ANDROID__)
+  void* provider = nullptr;
+  // Resolve against the provider instance ORT already loaded for the decoder.
+  // Opening MORPHIZEN_EP_LIB normally can create a second libhipgpu instance
+  // with a different thread-local current-stream slot.
+  if (const char* provider_path = std::getenv("AMDGPU_EP_PATH"))
+    provider = dlopen(provider_path, RTLD_NOW | RTLD_LOCAL | RTLD_NOLOAD);
+  if (!provider)
+    provider = dlopen("libhipgpu.so", RTLD_NOW | RTLD_LOCAL | RTLD_NOLOAD);
+  if (!provider)
+    return {};
+  auto get_symbol = [&](const char* name) { return dlsym(provider, name); };
+#else
+  return {};
+#endif
+
+  auto version = reinterpret_cast<HipEpDeviceApiVersionFn>(
+      get_symbol("hipdnn_ep_device_api_version"));
+  auto copy = reinterpret_cast<HipEpCopyStateSlotsFn>(
+      get_symbol("hipdnn_ep_copy_state_slots"));
+  if (!version || version() != kHipEpDeviceApiVersion || !copy)
+    return {};
+  return {copy};
+}
+
+HipEpCopyStateSlotsFn GetHipEpCopyStateSlots() {
+  static std::mutex mutex;
+  static std::atomic<HipEpCopyStateSlotsFn> copy_state_slots{};
+  if (auto copy = copy_state_slots.load(std::memory_order_acquire))
+    return copy;
+  std::lock_guard<std::mutex> lock(mutex);
+  if (auto copy = copy_state_slots.load(std::memory_order_relaxed))
+    return copy;
+  const auto api = ResolveHipEpDeviceApi();
+  if (api.copy_state_slots)
+    copy_state_slots.store(api.copy_state_slots, std::memory_order_release);
+  return api.copy_state_slots;
+}
