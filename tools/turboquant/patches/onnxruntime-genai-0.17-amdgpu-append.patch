+void StandardDecodingStrategy::PrepareForAppend(Generator& g) {
+  // Token selection appends to the sequence before its KV is evaluated. Flush
+  // that one token before adding a new prompt so positions and cached history
+  // describe the same committed sequence. Already-computed logits need no work.
+  if (g.last_action_ == Generator::Action::generated && !g.computed_logits_)
+    g.ComputeLogits(g.search_->GetNextTokens());
+}
